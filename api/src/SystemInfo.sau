-- What Settings' About pane shows: the system, as the window manager sees
-- it. Copied across the process boundary, so plain values only; anything
-- that could not be found is empty or 0.

from GraphicsDevice import GraphicsDevice

export class SystemInfo
  -- Saule's version, and the window manager's.
  saule: string = ""
  wm: string = ""

  -- What the computer is, as its firmware names it, e.g. "HP Mini
  -- 210-1001SA".
  machine: string = ""

  -- The processor's name, e.g. "Intel(R) Atom(TM) CPU N450 @ 1.66GHz",
  -- and how many threads it runs at once.
  processor: string = ""
  cores: integer = 0

  -- The graphics hardware, e.g. "Intel GMA 3150"; several are joined with
  -- commas.
  graphics: string = ""

  -- Every graphics chip, each with its driver and whether the screen is
  -- on it (Saule Linux; empty elsewhere). And what the screen is drawn
  -- by: a chip, as it names itself, or "" when the processor does the
  -- drawing because no chip has a driver that can.
  cards: table<GraphicsDevice> = {}
  renderer: string = ""

  -- Why the processor draws, when it does: what the graphics driver
  -- said, as Shine had it (`Graphics.getRendererProblem`).
  rendererProblem: string = ""

  -- The kernel's release, e.g. "6.18.64-saule".
  kernel: string = ""

  -- Memory, in kB: all there is, and what programs are using of it now
  -- (the rest is free, or holds files the kernel gives up when asked).
  -- And how long the system has been up, in seconds.
  memory: integer = 0
  memoryUsed: integer = 0
  uptime: integer = 0

  -- The main disk, said in a line: "250.06 GB hard disk · 249.85 GB available", or
  -- "" when there is none.
  storage: string = ""

  -- The screen's resolution, in its own pixels.
  screenWidth: integer = 0
  screenHeight: integer = 0

  -- How many windows are open, on every workspace.
  windows: integer = 0

  -- Where the window manager runs: "saule" on the screen of Saule Linux,
  -- or nested in a window on "windows", "macos" or "linux". Nested, the
  -- desktop around moves the pointer.
  host: string = ""
end
