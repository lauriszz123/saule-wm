-- wmapi — how other programs talk to the window manager: the settings
-- service it serves as `saule.wm` (Settings is its client), the values that
-- cross between them, and the presets both sides name.
--
-- Its own package, so an app can depend on it without depending on the
-- window manager. Nothing in here knows about uikit; the one thing that
-- draws, `WallpaperArt`, draws with Shine alone, so Settings' pictures of
-- the wallpapers are drawn by the same code as the screen's.

export from WmOptions import *
export from GraphicsDevice import *
export from SystemInfo import *
export from Rgba import *
export from Preset import *
export from Presets import *
export from WallpaperArt import *
export from WmService import *
export from KeyAction import *
export from KeyActions import *
export from StorageVolume import *
export from StorageCategory import *
export from StorageReport import *
export from InputDevice import *
export from WifiNetwork import *
export from SoundOutput import *
export from BluetoothDevice import *
export from MachineInfo import *
export from WmSettings import *
export from WmApp import *
