-- How each wallpaper looks: drawn with Shine into whatever is being drawn
-- on, at any size — the window manager's screen, or Settings' small
-- pictures of them — so both show the same thing.
--
--   WallpaperArt.paint("hills", 0.0, 0.0, w, h, 0.0)
--
-- Four kinds (see `Presets`): a photograph, from a file; a gradient, a
-- soft wash with a glow; an
-- animated gradient, the wash with glows of colour drifting across it,
-- drawn as they are `time` seconds in; and a picture, a landscape made of
-- layered curves, gradients and blur, in the manner of the Mac's. A
-- picture is all its own drawing — no image is stored anywhere — so it is
-- sharp at every size.
--
-- A gradient or a picture is the same every time it is drawn: draw it once
-- into an image and copy that. An animated one changes every frame.

import shine
from Rgba import Rgba
from Preset import Preset
from Presets import Presets

export class WallpaperArt
  -- The width a picture is designed at: its blurs and lines scale with
  -- the width it is drawn at.
  static designWidth: float = 1440.0

  -- Where the photographs are, first found first: `SAULE_WALLPAPERS`,
  -- Saule Linux's own, then `wallpapers` where the window manager was
  -- started (its project, when it runs nested).
  static folders: table<string> = {"/usr/share/saule/wallpapers", "wallpapers"}

  -- Photographs loaded, by file: decoding one takes a while, and the same
  -- one is drawn again whenever the screen changes size.
  static local photos: table<string, Image> = {}

  -- Draw the wallpaper called `name` over `w` × `h` at (`x`, `y`).
  static fn paint(
    name: string,
    x: float,
    y: float,
    w: float,
    h: float,
    time: float
  ) -> nil
    local preset = Presets.wallpaper(name)
    Graphics.push("all")
    match Presets.kind(preset.name)
      case "photo" then WallpaperArt.photo(preset, x, y, w, h)
      case "picture" then WallpaperArt.picture(preset, x, y, w, h)
      case "animated" then WallpaperArt.animated(preset, x, y, w, h, time)
      case _ then WallpaperArt.gradient(preset, x, y, w, h)
    end
    Graphics.clearGradient()
    Graphics.pop()
  end

  -- Whether the wallpaper called `name` moves.
  static fn moves(name: string) -> boolean
    return Presets.kind(name) == "animated"
  end

  -- The photograph called by `preset`'s name, covering the rectangle as
  -- `object-fit: cover` does: as small as it can be and still fill it,
  -- centred, what is left over cut off. Under 400 pixels wide (Settings'
  -- pictures of them) its small version is used: shrinking the large one
  -- that far would leave it grainy. With no file, its colours as a wash.
  static fn photo(preset: Preset, x: float, y: float, w: float, h: float) -> nil
    local image = WallpaperArt.photoImage(preset.name, w < 400.0)
    if image == nil then
      local c = preset.colours
      WallpaperArt.vertical(x, y, w, h, {c[1], c[2], c[3]})
      return
    end
    local iw = image!.getWidth() as float
    local ih = image!.getHeight() as float
    local scale = Math.max(w / iw, h / ih)
    local left = x + (w - iw * scale) / 2.0
    local top = y + (h - ih * scale) / 2.0
    Graphics.intersectScissor(x, y, w, h)
    Graphics.setColor(1.0, 1.0, 1.0, 1.0)
    Graphics.draw(image!, left, top, 0.0, scale, scale)
  end

  -- The photograph called `name` (its small version when `small`),
  -- loaded once and kept; nil when no folder has it.
  static fn photoImage(name: string, small: boolean) -> Image?
    local file = name .. ".jpg"
    if small then
      file = name .. "-small.jpg"
    end
    local kept = WallpaperArt.photos[file]
    if kept != nil then
      return kept
    end
    local folders: table<string> = {}
    local asked = Os.getenv("SAULE_WALLPAPERS")
    if asked != nil then
      Table.insert(folders, asked!)
    end
    for folder in WallpaperArt.folders do
      Table.insert(folders, folder)
    end
    for folder in folders do
      local image = Graphics.loadImage(folder .. "/" .. file)
      if image != nil then
        -- The large ones are big: keep only the last one used.
        if not small then
          WallpaperArt.forgetLarge()
        end
        WallpaperArt.photos[file] = image!
        return image
      end
    end
    return nil
  end

  -- Let go of every large photograph kept, so only one is in memory.
  static fn forgetLarge() -> nil
    local keep: table<string, Image> = {}
    for file, image in WallpaperArt.photos do
      if String.contains(file, "-small") then
        keep[file] = image
      end
    end
    WallpaperArt.photos = keep
  end

  -- A wash from the top left to the bottom right, and a glow up on the
  -- right.
  static fn gradient(preset: Preset, x: float, y: float, w: float, h: float) -> nil
    local c = preset.colours
    WallpaperArt.wash(x, y, w, h, c[1], c[2], c[3])
    WallpaperArt.glow(x + w * 0.85, y + h * 0.15, w * 0.55, c[4], x, y, w, h)
  end

  -- The wash, and three glows wandering over it, each on its own slow
  -- path: what they are `time` seconds in.
  static fn animated(
    preset: Preset,
    x: float,
    y: float,
    w: float,
    h: float,
    time: float
  ) -> nil
    local c = preset.colours
    WallpaperArt.wash(x, y, w, h, c[1], c[2], c[3])
    local reach = Math.max(w, h) * 0.62
    for i = 1, 3 do
      local n = i as float
      local speed = 0.11 + n * 0.035
      local phase = n * 2.1
      local gx = x + w * (0.5 + 0.38 * Math.sin(time * speed + phase))
      local cy = time * speed * 0.83 + phase * 1.3
      local gy = y + h * (0.5 + 0.36 * Math.cos(cy))
      WallpaperArt.glow(gx, gy, reach, c[3 + i], x, y, w, h)
    end
  end

  -- The picture called by `preset`'s name.
  static fn picture(preset: Preset, x: float, y: float, w: float, h: float) -> nil
    match preset.name
      case "hills" then WallpaperArt.hills(x, y, w, h)
      case "dunes" then WallpaperArt.dunes(x, y, w, h)
      case "peaks" then WallpaperArt.peaks(x, y, w, h)
      case "waves" then WallpaperArt.waves(x, y, w, h)
      case _ then WallpaperArt.lake(x, y, w, h)
    end
  end

  -- Rolling green hills under a soft morning sky, paler with distance.
  static fn hills(x: float, y: float, w: float, h: float) -> nil
    WallpaperArt.sky(
      x,
      y,
      w,
      h,
      {
        Rgba(0.42, 0.60, 0.84),
        Rgba(0.66, 0.77, 0.90),
        Rgba(0.95, 0.88, 0.80),
      }
    )
    WallpaperArt.glow(
      x + w * 0.72,
      y + h * 0.42,
      w * 0.45,
      Rgba(1.0, 0.93, 0.78, 0.75),
      x,
      y,
      w,
      h
    )
    local s = w / WallpaperArt.designWidth
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.55,
      {0.035, 0.02, 0.008},
      {1.3, 2.7, 6.1},
      {0.4, 1.9, 0.3},
      false,
      Rgba(0.64, 0.72, 0.80),
      Rgba(0.74, 0.79, 0.84)
    )
    Graphics.blur(x, y, w, h, 6.0 * s)
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.62,
      {0.04, 0.02, 0.007},
      {0.9, 2.2, 5.3},
      {2.2, 0.7, 1.1},
      false,
      Rgba(0.50, 0.63, 0.60),
      Rgba(0.60, 0.70, 0.64)
    )
    Graphics.blur(x, y, w, h, 3.0 * s)
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.70,
      {0.05, 0.018, 0.006},
      {1.1, 2.9, 7.0},
      {1.0, 2.6, 0.2},
      false,
      Rgba(0.38, 0.55, 0.42),
      Rgba(0.44, 0.60, 0.44)
    )
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.79,
      {0.055, 0.02, 0.006},
      {0.7, 1.9, 6.4},
      {3.0, 0.2, 2.4},
      false,
      Rgba(0.28, 0.45, 0.31),
      Rgba(0.30, 0.47, 0.30)
    )
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.90,
      {0.05, 0.015, 0.005},
      {0.5, 1.6, 5.0},
      {0.6, 1.5, 2.9},
      false,
      Rgba(0.19, 0.33, 0.22),
      Rgba(0.11, 0.21, 0.15)
    )
  end

  -- Warm desert dunes under a pale blue sky, light on their crests and
  -- shadowed in their hollows.
  static fn dunes(x: float, y: float, w: float, h: float) -> nil
    WallpaperArt.sky(
      x,
      y,
      w,
      h,
      {
        Rgba(0.33, 0.52, 0.82),
        Rgba(0.66, 0.76, 0.90),
        Rgba(0.98, 0.88, 0.76),
      }
    )
    WallpaperArt.glow(
      x + w * 0.25,
      y + h * 0.45,
      w * 0.5,
      Rgba(1.0, 0.92, 0.80, 0.6),
      x,
      y,
      w,
      h
    )
    local s = w / WallpaperArt.designWidth
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.58,
      {0.05, 0.015, 0.0},
      {1.2, 3.1, 1.0},
      {0.3, 1.2, 0.0},
      true,
      Rgba(0.93, 0.74, 0.58),
      Rgba(0.86, 0.62, 0.46)
    )
    Graphics.blur(x, y, w, h, 4.0 * s)
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.68,
      {0.07, 0.02, 0.0},
      {0.9, 2.4, 1.0},
      {1.4, 0.4, 0.0},
      true,
      Rgba(0.95, 0.70, 0.50),
      Rgba(0.78, 0.50, 0.34)
    )
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.80,
      {0.08, 0.02, 0.0},
      {0.75, 2.0, 1.0},
      {2.6, 1.1, 0.0},
      true,
      Rgba(0.92, 0.62, 0.42),
      Rgba(0.66, 0.38, 0.25)
    )
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.92,
      {0.07, 0.015, 0.0},
      {0.55, 1.7, 1.0},
      {0.9, 2.2, 0.0},
      true,
      Rgba(0.84, 0.52, 0.34),
      Rgba(0.50, 0.27, 0.18)
    )
  end

  -- Mountains at dusk, range behind range, each fainter and mistier with
  -- distance, over a calm sea that holds the sky's last light.
  static fn peaks(x: float, y: float, w: float, h: float) -> nil
    WallpaperArt.sky(
      x,
      y,
      w,
      h * 0.8,
      {
        Rgba(0.24, 0.20, 0.48),
        Rgba(0.58, 0.40, 0.66),
        Rgba(0.99, 0.70, 0.56),
      }
    )
    WallpaperArt.glow(
      x + w * 0.5,
      y + h * 0.66,
      w * 0.45,
      Rgba(1.0, 0.84, 0.66, 0.7),
      x,
      y,
      w,
      h
    )
    local s = w / WallpaperArt.designWidth
    -- Far, then middle, then near: each misty at its foot, where it meets
    -- the next.
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.52,
      {0.08, 0.03, 0.012},
      {1.6, 4.3, 11.0},
      {0.2, 1.3, 0.7},
      true,
      Rgba(0.66, 0.52, 0.72),
      Rgba(0.92, 0.72, 0.72)
    )
    Graphics.blur(x, y, w, h * 0.8, 6.0 * s)
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.62,
      {0.09, 0.03, 0.01},
      {1.2, 3.7, 9.0},
      {1.8, 0.4, 2.2},
      true,
      Rgba(0.44, 0.34, 0.60),
      Rgba(0.80, 0.58, 0.68)
    )
    Graphics.blur(x, y, w, h * 0.8, 2.0 * s)
    WallpaperArt.ridge(
      x,
      y,
      w,
      h,
      0.72,
      {0.10, 0.025, 0.01},
      {0.9, 3.1, 8.0},
      {0.7, 2.6, 1.4},
      true,
      Rgba(0.26, 0.20, 0.42),
      Rgba(0.52, 0.38, 0.58)
    )
    -- The sea, from the shore down: the glow of the sky in it, darkening.
    local shore = y + h * 0.8
    WallpaperArt.vertical(
      x,
      shore,
      w,
      y + h - shore,
      {
        Rgba(0.86, 0.62, 0.62),
        Rgba(0.42, 0.32, 0.54),
        Rgba(0.14, 0.11, 0.28),
      }
    )
    WallpaperArt.glow(
      x + w * 0.5,
      shore,
      w * 0.3,
      Rgba(1.0, 0.86, 0.72, 0.45),
      x,
      shore,
      w,
      y + h - shore
    )
  end

  -- Flowing ribbons of colour, one over another, each lifted off the one
  -- under it by a soft shadow.
  static fn waves(x: float, y: float, w: float, h: float) -> nil
    WallpaperArt.sky(
      x,
      y,
      w,
      h,
      {Rgba(0.10, 0.06, 0.28), Rgba(0.18, 0.12, 0.45), Rgba(0.30, 0.20, 0.62)}
    )
    local colours = {
      {Rgba(0.30, 0.36, 0.90), Rgba(0.45, 0.60, 1.0)},
      {Rgba(0.55, 0.32, 0.88), Rgba(0.80, 0.45, 0.90)},
      {Rgba(0.85, 0.36, 0.62), Rgba(0.98, 0.58, 0.60)},
      {Rgba(0.98, 0.56, 0.42), Rgba(1.0, 0.78, 0.52)},
      {Rgba(0.20, 0.62, 0.86), Rgba(0.45, 0.88, 0.92)},
    }
    for i = 1, 5 do
      local n = i as float
      local base = 0.22 + n * 0.14
      local amps = {0.09, 0.03, 0.01}
      local freqs = {0.6 + n * 0.11, 1.7, 3.3}
      local phases = {n * 1.7, n * 0.6, n * 2.3}
      -- The shadow: the same shape a little higher, in faint layers
      -- that darken toward the ribbon's edge.
      for k = 1, 12 do
        local lift = (13 - k) as float * 0.002
        local dark = Rgba(0.02, 0.0, 0.10, 0.04)
        WallpaperArt.ridge(
          x,
          y - h * lift,
          w,
          h,
          base,
          amps,
          freqs,
          phases,
          false,
          dark,
          dark
        )
      end
      local pair = colours[i]
      WallpaperArt.ridge(
        x,
        y,
        w,
        h,
        base,
        amps,
        freqs,
        phases,
        false,
        pair[2],
        pair[1]
      )
    end
  end

  -- A mountain lake at night: stars, the moon, the range and its
  -- reflection in still water.
  static fn lake(x: float, y: float, w: float, h: float) -> nil
    WallpaperArt.sky(
      x,
      y,
      w,
      h,
      {Rgba(0.02, 0.03, 0.10), Rgba(0.06, 0.08, 0.22), Rgba(0.24, 0.26, 0.46)}
    )
    WallpaperArt.stars(x, y, w, h * 0.55)
    local mx = x + w * 0.72
    local my = y + h * 0.2
    WallpaperArt.glow(mx, my, w * 0.16, Rgba(0.80, 0.86, 1.0, 0.30), x, y, w, h)
    WallpaperArt.glow(
      mx,
      my,
      w * 0.045,
      Rgba(0.90, 0.94, 1.0, 0.45),
      x,
      y,
      w,
      h
    )
    Graphics.setColor(0.96, 0.97, 1.0, 1.0)
    Graphics.circle("fill", mx, my, w * 0.016)
    local s = w / WallpaperArt.designWidth
    local horizon = 0.66

    -- The water: the sky's lower colours, darker, under the range.
    local top = y + h * horizon
    WallpaperArt.vertical(
      x,
      top,
      w,
      y + h - top,
      {Rgba(0.16, 0.18, 0.34), Rgba(0.06, 0.07, 0.17), Rgba(0.02, 0.03, 0.08)}
    )
    -- The reflection: the range upside down, faint and blurred.
    Graphics.push()
    Graphics.translate(0.0, top * 2.0)
    Graphics.scale(1.0, -1.0)
    WallpaperArt.range(x, y, w, h, horizon, Rgba(0.08, 0.10, 0.22, 0.9))
    Graphics.pop()
    Graphics.blur(x, top, w, y + h - top, 8.0 * s)
    WallpaperArt.range(x, y, w, h, horizon, Rgba(0.04, 0.05, 0.12))
    -- Moonlight on the water: a soft streak down from the moon.
    for k = 0, 5 do
      local f = k as float
      WallpaperArt.glow(
        mx,
        top + h * (0.03 + f * 0.05),
        w * (0.05 - f * 0.005),
        Rgba(0.80, 0.86, 1.0, 0.22 - f * 0.03),
        x,
        top,
        w,
        y + h - top
      )
    end
  end

  -- The lake's mountains, down to `horizon`: a jagged line, filled.
  static fn range(
    x: float,
    y: float,
    w: float,
    h: float,
    horizon: float,
    colour: Rgba
  ) -> nil
    local points: table<float> = {}
    local steps = 160
    for i = 0, steps do
      local u = (i as float) / (steps as float)
      local peak = 0.13 * Math.abs(Math.sin(u * 2.6 + 0.5))
      peak += 0.07 * Math.abs(Math.sin(u * 6.9 + 1.2))
      peak += 0.025 * Math.abs(Math.sin(u * 17.0 + 0.3))
      peak += 0.008 * Math.sin(u * 41.0)
      Table.insert(points, x + u * w)
      Table.insert(points, y + h * (horizon - 0.02 - peak))
    end
    Table.insert(points, x + w)
    Table.insert(points, y + h * horizon)
    Table.insert(points, x)
    Table.insert(points, y + h * horizon)
    Graphics.setColor(colour.r, colour.g, colour.b, colour.a)
    Graphics.polygon("fill", points)
  end

  -- Small stars over the top of the sky, the same every time.
  static fn stars(x: float, y: float, w: float, h: float) -> nil
    local seed = 12345
    local size = Math.max(w / WallpaperArt.designWidth, 0.25)
    for i = 1, 140 do
      seed = (seed * 1103515245 + 12345) % 2147483648
      local sx = (seed % 10000) as float / 10000.0
      seed = (seed * 1103515245 + 12345) % 2147483648
      local sy = (seed % 10000) as float / 10000.0
      seed = (seed * 1103515245 + 12345) % 2147483648
      local bright = 0.35 + ((seed % 100) as float) / 160.0
      Graphics.setColor(0.92, 0.94, 1.0, bright)
      local r = size * (0.6 + bright)
      Graphics.circle("fill", x + sx * w, y + sy * sy * h, r)
    end
  end

  -- Land from a wavy line at `base` (of the height) down to the bottom:
  -- the line a sum of sines (`amps`, `freqs` in waves across, `phases`),
  -- or of their peaks only when `sharp` (crests, as dunes and mountains
  -- have). Filled from `top` at the line to `bottom` at the bottom.
  static fn ridge(
    x: float,
    y: float,
    w: float,
    h: float,
    base: float,
    amps: table<float>,
    freqs: table<float>,
    phases: table<float>,
    sharp: boolean,
    top: Rgba,
    bottom: Rgba
  ) -> nil
    local points: table<float> = {}
    local steps = 128
    local highest = y + h
    for i = 0, steps do
      local u = (i as float) / (steps as float)
      local lift = 0.0
      for k = 1, #amps do
        local wave = Math.sin(u * freqs[k] * Math.pi * 2.0 + phases[k])
        if sharp then
          wave = Math.abs(wave) * 2.0 - 1.0
        end
        lift += amps[k] * wave
      end
      local py = y + h * (base - lift)
      highest = Math.min(highest, py)
      Table.insert(points, x + u * w)
      Table.insert(points, py)
    end
    Table.insert(points, x + w)
    Table.insert(points, y + h)
    Table.insert(points, x)
    Table.insert(points, y + h)
    Graphics.setColor(1.0, 1.0, 1.0, 1.0)
    Graphics.setLinearGradient(
      x,
      highest,
      x,
      y + h,
      WallpaperArt.stops({top, bottom})
    )
    Graphics.polygon("fill", points)
    Graphics.clearGradient()
  end

  -- The sky: `colours` from the top down.
  static fn sky(x: float, y: float, w: float, h: float, colours: table<Rgba>) -> nil
    WallpaperArt.vertical(x, y, w, h, colours)
  end

  -- `colours` from the top of the rectangle to its bottom.
  static fn vertical(
    x: float,
    y: float,
    w: float,
    h: float,
    colours: table<Rgba>
  ) -> nil
    Graphics.setColor(1.0, 1.0, 1.0, 1.0)
    Graphics.setLinearGradient(x, y, x, y + h, WallpaperArt.stops(colours))
    Graphics.rectangle("fill", x, y, w, h)
    Graphics.clearGradient()
  end

  -- A wash from the top left corner to the bottom right.
  static fn wash(
    x: float,
    y: float,
    w: float,
    h: float,
    a: Rgba,
    b: Rgba,
    c: Rgba
  ) -> nil
    Graphics.setColor(1.0, 1.0, 1.0, 1.0)
    Graphics.setLinearGradient(
      x,
      y,
      x + w,
      y + h,
      WallpaperArt.stops({a, b, c})
    )
    Graphics.rectangle("fill", x, y, w, h)
    Graphics.clearGradient()
  end

  -- A soft round glow of `colour` at (`cx`, `cy`), fading out by
  -- `radius`, over the rectangle.
  static fn glow(
    cx: float,
    cy: float,
    radius: float,
    colour: Rgba,
    x: float,
    y: float,
    w: float,
    h: float
  ) -> nil
    local clear = Rgba(colour.r, colour.g, colour.b, 0.0)
    Graphics.setColor(1.0, 1.0, 1.0, 1.0)
    Graphics.setRadialGradient(
      cx,
      cy,
      radius,
      WallpaperArt.stops({colour, clear})
    )
    Graphics.rectangle("fill", x, y, w, h)
    Graphics.clearGradient()
  end

  -- Gradient stops the way Shine takes them: for each colour, where it
  -- sits from 0 to 1, then its red, green, blue and alpha.
  static fn stops(colours: table<Rgba>) -> table<float>
    local stops: table<float> = {}
    local last = Math.max(#colours - 1, 1) as float
    for i = 1, #colours do
      local colour = colours[i]
      Table.insert(stops, ((i - 1) as float) / last)
      Table.insert(stops, colour.r)
      Table.insert(stops, colour.g)
      Table.insert(stops, colour.b)
      Table.insert(stops, colour.a)
    end
    return stops
  end
end
