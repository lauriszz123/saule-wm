-- The accents and wallpapers there are to choose from. Both sides use these
-- lists: Settings to show the swatches, the window manager to paint with
-- the one chosen. The first of each is the default.

from Rgba import Rgba
from Preset import Preset

export class Presets
  -- One colour each.
  static accents: table<Preset> = {
    Preset("blue", "Blue", {Rgba(0.48, 0.64, 0.97)}),
    Preset("purple", "Purple", {Rgba(0.69, 0.52, 0.96)}),
    Preset("pink", "Pink", {Rgba(0.96, 0.49, 0.72)}),
    Preset("orange", "Orange", {Rgba(0.98, 0.64, 0.33)}),
    Preset("green", "Green", {Rgba(0.45, 0.82, 0.52)}),
    Preset("graphite", "Graphite", {Rgba(0.62, 0.64, 0.68)}),
  }

  -- Four colours each: the wash's top left, middle and bottom right, then
  -- the glow up on the right.
  static wallpapers: table<Preset> = {
    Preset(
      "dusk",
      "Dusk",
      Presets.wash(
        Rgba(0.09, 0.12, 0.30),
        Rgba(0.30, 0.20, 0.50),
        Rgba(0.85, 0.48, 0.52),
        Rgba(1.0, 0.70, 0.56, 0.40)
      )
    ),
    Preset(
      "ocean",
      "Ocean",
      Presets.wash(
        Rgba(0.03, 0.10, 0.22),
        Rgba(0.06, 0.30, 0.46),
        Rgba(0.30, 0.70, 0.74),
        Rgba(0.60, 0.92, 0.90, 0.35)
      )
    ),
    Preset(
      "forest",
      "Forest",
      Presets.wash(
        Rgba(0.04, 0.12, 0.10),
        Rgba(0.12, 0.30, 0.20),
        Rgba(0.55, 0.66, 0.38),
        Rgba(0.95, 0.90, 0.60, 0.35)
      )
    ),
    Preset(
      "ember",
      "Ember",
      Presets.wash(
        Rgba(0.14, 0.05, 0.08),
        Rgba(0.45, 0.12, 0.16),
        Rgba(0.95, 0.52, 0.28),
        Rgba(1.0, 0.80, 0.45, 0.40)
      )
    ),
    Preset(
      "graphite",
      "Graphite",
      Presets.wash(
        Rgba(0.08, 0.08, 0.10),
        Rgba(0.20, 0.21, 0.24),
        Rgba(0.42, 0.44, 0.48),
        Rgba(0.85, 0.87, 0.92, 0.25)
      )
    ),
  }

  -- A wallpaper's colours, in the order the window manager paints them:
  -- the wash from the top left through the middle to the bottom right
  -- (`low`), then the glow.
  static fn wash(top: Rgba, middle: Rgba, low: Rgba, glow: Rgba) -> table<Rgba>
    return {top, middle, low, glow}
  end

  -- The preset called `name` in `list`, or the first when there is none:
  -- a name from an older Settings still gets something.
  static fn find(list: table<Preset>, name: string) -> Preset
    for preset in list do
      if preset.name == name then
        return preset
      end
    end
    return list[1]
  end
end
