  -- A wallpaper's colours, in the order the window manager paints them:
  -- the wash from the top left through the middle to the bottom right
  -- (`low`), then the glow.
  static fn wash(top: Rgba, middle: Rgba, low: Rgba, glow: Rgba) -> table<Rgba>
    return {top, middle, low, glow}
  end

  -- The wallpaper called `name`, whichever kind it is: a picture, a
  -- gradient or an animated one; the first gradient when there is none.
  static fn wallpaper(name: string) -> Preset
    local lists = {
      Presets.photos,
      Presets.pictures,
      Presets.wallpapers,
      Presets.animated,
    }
    for list in lists do
      for preset in list do
        if preset.name == name then
          return preset
        end
      end
    end
    return Presets.wallpapers[1]
  end

  -- Which kind the wallpaper called `name` is: "photo", "picture",
  -- "animated" or "gradient".
  static fn kind(name: string) -> string
    for preset in Presets.photos do
      if preset.name == name then
        return "photo"
      end
    end
    for preset in Presets.pictures do
      if preset.name == name then
        return "picture"
      end
    end
    for preset in Presets.animated do
      if preset.name == name then
        return "animated"
      end
    end
    return "gradient"
  end

  -- The preset called `name` in `list`, or the first when there is none:
  -- a name from an older Settings still gets something.
  static fn find(list: table<Preset>, name: string) -> Preset
    for preset in list do
      if preset.name == name then
        return preset
      end
    end
    return list[1]
  end
end
