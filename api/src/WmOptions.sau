-- The window manager's settings, as Settings shows and changes them.
-- Copied whole across the process boundary, so it holds only plain values:
-- the choices that are named (an accent, a wallpaper, where new windows go)
-- are sent by name, as enums cannot cross yet.

export class WmOptions
  -- Space between windows, and between them and the screen's edges.
  gap: float = 4.0

  -- How far into a window the gap next to it can be grabbed.
  grab: float = 4.0

  -- How much weight one arrow key moves in resize mode.
  resizeStep: integer = 10

  -- Where the next window goes: "beside" or "below" the focused one.
  newWindows: string = "beside"

  -- How windows are arranged: tiled, each given its share of the screen,
  -- or (`windowed`) every one its own size, dragged about and
  -- overlapping, as on a Mac. Switching moves the windows there are.
  windowed: boolean = false

  -- The Dock along the foot of the screen: the apps, and the windows
  -- that were minimised.
  dock: boolean = true

  -- The accent colour, by name: see `Presets.accents`.
  accent: string = "blue"

  -- How round windows' corners are.
  corners: float = 8.0

  -- The wallpaper, by name: see `Presets.wallpapers`.
  wallpaper: string = "dusk"

  -- How far the pointer goes for a mouse's movement, and the wheel scrolls
  -- for a turn: 1 as the hardware reports them.
  pointerSpeed: float = 1.0
  scrollSpeed: float = 1.0

  -- The wheel the other way round: what is scrolled moves the way the
  -- fingers do.
  naturalScrolling: boolean = false

  -- Which button clicks: "left", or "right" for a left hand.
  primaryButton: string = "left"

  -- A trackpad's own: how far the pointer goes for a finger's movement
  -- and two fingers scroll, whether what is scrolled moves the way the
  -- fingers do (as on a Mac, it does unless turned off), and whether a
  -- tap is a click.
  trackpadSpeed: float = 1.0
  trackpadScrollSpeed: float = 1.0
  trackpadNaturalScrolling: boolean = true
  tapToClick: boolean = true

  -- The keyboard layouts typed with, by XKB's names, joined with commas:
  -- "lt,us". The first is the one in use when the computer starts; a
  -- shortcut goes round them. "" is the one chosen when the system was
  -- installed, or a US keyboard.
  keyboardLayouts: string = ""

  -- A window gets the keyboard when the pointer moves onto it, without a
  -- click.
  focusFollowsPointer: boolean = false

  -- The key every shortcut is held with, "Mod": "super", "alt" or
  -- "ctrl+alt", or "" for the one that suits where the window manager
  -- runs (see `WmSettings.keys`).
  modKey: string = ""

  -- The shortcuts changed from what they are by default, by action (see
  -- `KeyActions`), each written as its keys joined with "+":
  -- {launcher: "ctrl+alt+d"}. Any left out are as they are by default.
  shortcuts: table<string, string> = {}
end
