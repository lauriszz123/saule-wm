-- A colour as plain numbers: red, green, blue and alpha, each 0 to 1. Not
-- uikit's `Color`, so this package needs nothing that draws.

export class Rgba
  r: float
  g: float
  b: float
  a: float

  fn init(r: float, g: float, b: float, a: float = 1.0)
    self.r = r
    self.g = g
    self.b = b
    self.a = a
  end
end
