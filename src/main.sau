--[[
saule-wm: the Saule Linux display server and window manager.

  saule run . [app …]   start the given apps inside it
  On Saule Linux it starts everything in /bin/apps. Ctrl+Alt+Q quits.

The code is layered; each folder only uses the ones above it:

    wm    what it does: the apps' windows, starting apps. No drawing.
    ui    how it looks, as uikit views: desktop, status bar, windows
]]

-- `App` too: `run` is inherited from it.
from uikit import App
from WindowManagerApp import WindowManagerApp

class Main
  static fn main()
    WindowManagerApp(Os.args()).run()
  end
end
