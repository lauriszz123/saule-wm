--[[
saule-wm: the Saule Linux display server and window manager.

  saule run . [app …]   start the given apps inside it
  On Saule Linux nothing starts by itself: the apps in /bin/apps are
  opened from the launcher (Super+Space). Ctrl+Alt+Q quits. Nested in
  another desktop the keys are others: see `Keymap`.

The code is layered; each folder only uses the ones above it:

    wm       what it does: the apps' windows, starting apps. No drawing.
    ui       how it looks, as uikit views: desktop, status bar, windows
    service  what it does for other programs: Settings' `saule.wm`

  The settings service's interface is its own package, api/ (`wmapi`), so
  an app can use it without depending on the window manager.
]]

-- `App` too: `run` is inherited from it.
from uikit import App
from WindowManagerApp import WindowManagerApp
from service import Preferences

class Main
  static fn main()
    local app = WindowManagerApp(Os.args())
    app.run()

    -- A setting changed a moment before leaving is still waiting.
    Preferences.flush()

    -- Restart, Shut Down and Log Out end the app with a code for init.
    if app.session.exitCode != 0 then
      Os.exit(app.session.exitCode)
    end
  end
end
