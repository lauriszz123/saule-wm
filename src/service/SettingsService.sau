-- What the window manager answers Settings with: the `saule.wm` service
-- (wmapi's `WmSettings`). A change is applied as it arrives, to the
-- palette and the session, and the screen redrawn.
--
-- What is applied is also saved (`Preferences`), and what was saved is
-- applied when the window manager starts: settings outlive a restart.
--
-- Its values come from another process, so each is kept to a sensible
-- range rather than trusted: a gap of a thousand pixels would leave no
-- room for windows at all.

import shine
from uikit import Display
from "wmapi" import StorageReport, SystemInfo, WmOptions, WmService, WmSettings
from wm import Keymap, Pointer, Session, Split
from ui import Palette
from log import Logger
from GraphicsCard import GraphicsCard
from Preferences import Preferences
from Storage import Storage

export class SettingsService implements WmSettings
  static local log: Logger = Logger("wm.settings")

  session: Session

  fn init(session: Session)
    self.session = session
  end

  -- Serve it, for as long as the window manager runs. Another window
  -- manager already serving the name (a second one nested inside the
  -- first) leaves this one without Settings rather than without windows.
  static fn publish(session: Session) -> nil
    GraphicsCard.start()
    local service = SettingsService(session)
    local saved = Preferences.load()
    if saved != nil then
      service.use(saved!)
    end
    try
      WmSettings.publish(WmService.name, service)
      SettingsService.log.debug("serving", {service: WmService.name})
    catch e: string
      SettingsService.log.warn("no settings service", {reason: e})
    end
  end

  fn options() -> WmOptions
    local options = WmOptions()
    options.gap = Palette.gap
    options.grab = Palette.grab
    options.resizeStep = Session.resizeStep
    options.newWindows = "beside"
    if self.session.split == Split.Vertical then
      options.newWindows = "below"
    end
    options.accent = Palette.accentName
    options.corners = Palette.radius
    options.wallpaper = Palette.wallpaperName
    options.pointerSpeed = Pointer.speed
    options.scrollSpeed = Pointer.scrollSpeed
    options.naturalScrolling = Pointer.natural
    options.primaryButton = "left"
    if Pointer.swapped then
      options.primaryButton = "right"
    end
    options.focusFollowsPointer = Pointer.followsFocus
    options.modKey = Keymap.chosenMod
    local custom: table<string, string> = {}
    for name, keys in Keymap.custom do
      custom[name] = keys
    end
    options.shortcuts = custom
    return options
  end

  fn apply(options: WmOptions)
    self.use(options)
    Preferences.save(self.options())
    SettingsService.log.info(
      "settings applied",
      {
        gap: Palette.gap,
        corners: Palette.radius,
        accent: Palette.accentName,
        wallpaper: Palette.wallpaperName,
        newWindows: options.newWindows,
        mod: Keymap.scheme(),
        changedKeys: #Table.keys(Keymap.custom),
        pointer: Pointer.speed,
        scroll: Pointer.scrollSpeed,
        natural: Pointer.natural,
        leftHanded: Pointer.swapped,
        followsFocus: Pointer.followsFocus,
      }
    )
  end

  -- Make `options` the window manager's, each kept to its range.
  fn use(options: WmOptions) -> nil
    Palette.gap = Math.clamp(options.gap, 0.0, 24.0)
    Palette.grab = Math.clamp(options.grab, 0.0, 12.0)
    Session.resizeStep = Math.clamp(options.resizeStep, 1, 50)
    Palette.radius = Math.clamp(options.corners, 0.0, 16.0)
    Palette.useAccent(options.accent)
    Palette.useWallpaper(options.wallpaper)
    Keymap.configure(options.modKey, options.shortcuts)
    Pointer.configure(
      options.pointerSpeed,
      options.scrollSpeed,
      options.naturalScrolling,
      options.primaryButton == "right",
      options.focusFollowsPointer
    )

    local split = Split.Horizontal
    if options.newWindows == "below" then
      split = Split.Vertical
    end
    self.session.splitNext(split)
    self.session.refresh()
  end

  fn keys() -> table<string, string>
    return Keymap.written()
  end

  fn recordKeys(on: boolean)
    self.session.recordKeys(on)
    SettingsService.log.debug("recording keys", {on: on})
  end

  fn about() -> SystemInfo
    local info = SystemInfo()
    info.saule = Saule.full
    info.wm = Project.version
    info.machine = SettingsService.machine()
    info.kernel = SettingsService.firstLine("/proc/sys/kernel/osrelease")
    SettingsService.processor(info)
    info.graphics = GraphicsCard.name()
    SettingsService.memory(info)
    info.uptime = SettingsService.uptime()
    -- In the window manager's own pixels, which its layout uses: on a
    -- high-density screen there are more of the screen's own.
    local w, h = Window.getSize()
    info.screenWidth = Display.toLogical(w as float) as integer
    info.screenHeight = Display.toLogical(h as float) as integer
    info.windows = #self.session.clients
    info.host = Keymap.host
    info.storage = Storage.summary()
    return info
  end

  fn storage() -> StorageReport
    return Storage.report()
  end

  -- The first line of `path`, or "" where there is no such file (on a
  -- system without `/proc`).
  static fn firstLine(path: string) -> string
    local file = Io.open(path, IoMode.Read)
    if file == nil then
      return ""
    end
    local line = file!.read("l") ?? ""
    file!.close()
    return String.trim(line)
  end

  -- The computer's name from its firmware (DMI): the product, or the maker
  -- when the product says nothing, as a board's "To Be Filled By O.E.M."
  -- does.
  static fn machine() -> string
    local dmi = "/sys/class/dmi/id/"
    local product = SettingsService.firstLine(dmi .. "product_name")
    if product != "" and not String.contains(product, "O.E.M") then
      return product
    end
    return SettingsService.firstLine(dmi .. "sys_vendor")
  end

  -- The processor's name and threads, from `/proc/cpuinfo`: one block per
  -- thread, each with a "model name : …" line.
  static fn processor(info: SystemInfo) -> nil
    local file = Io.open("/proc/cpuinfo", IoMode.Read)
    if file == nil then
      return
    end
    local text = file!.read("a") ?? ""
    file!.close()

    for line in String.split(text, "\n") do
      if String.starts(line, "model name") then
        info.cores += 1
        local parts = String.split(line, ":")
        if info.processor == "" and #parts > 1 then
          -- The kernel pads the name with spaces: "CPU N450   @ 1.66GHz".
          local name = String.trim(parts[2])
          while String.contains(name, "  ") do
            name = String.replace(name, "  ", " ")
          end
          info.processor = name
        end
      end
    end
  end

  -- Memory from `/proc/meminfo`, in kB: all of it ("MemTotal:  2041128
  -- kB"), and what is in use: all but `MemAvailable`, the kernel's own
  -- count of what a new program could have, which is the free memory and
  -- the files it holds only until the room is wanted.
  static fn memory(info: SystemInfo) -> nil
    local file = Io.open("/proc/meminfo", IoMode.Read)
    if file == nil then
      return
    end
    local text = file!.read("a") ?? ""
    file!.close()

    local available = -1
    for line in String.split(text, "\n") do
      if String.starts(line, "MemTotal:") then
        info.memory = SettingsService.kilobytes(line)
      elseif String.starts(line, "MemAvailable:") then
        available = SettingsService.kilobytes(line)
      end
    end
    if available >= 0 then
      info.memoryUsed = Math.max(info.memory - available, 0)
    end
  end

  -- The number in a `/proc/meminfo` line: "MemTotal:  2041128 kB".
  static fn kilobytes(line: string) -> integer
    for word in String.split(line, " ") do
      local number = word as integer?
      if number != nil then
        return number!
      end
    end
    return 0
  end

  -- Whole seconds since boot, from `/proc/uptime`: "8312.54 15873.20".
  static fn uptime() -> integer
    local line = SettingsService.firstLine("/proc/uptime")
    local seconds = (String.split(line, " ")[1] as float?) ?? 0.0
    return seconds as integer
  end
end
