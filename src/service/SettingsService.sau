-- What the window manager answers Settings with: the `saule.wm` service
-- (wmapi's `WmSettings`). A change is applied as it arrives, to the
-- palette and the session, and the screen redrawn.
--
-- What is applied is also saved (`Preferences`), and what was saved is
-- applied when the window manager starts: settings outlive a restart.
--
-- Its values come from another process, so each is kept to a sensible
-- range rather than trusted: a gap of a thousand pixels would leave no
-- room for windows at all.

import shine
from uikit import Display
from "wmapi" import BluetoothDevice, MachineInfo, SoundOutput, StorageReport, SystemInfo, WifiNetwork, WmOptions, WmService, WmSettings
from wm import AppInfo, Hardware, Keymap, Launcher, Layouts, Machine, Pointer, Session, Split, System, Zones
from ui import Palette
from log import Logger
from GraphicsCard import GraphicsCard
from HostInfo import HostInfo
from Preferences import Preferences
from Storage import Storage

export class SettingsService implements WmSettings
  static local log: Logger = Logger("wm.settings")

  session: Session

  fn init(session: Session)
    self.session = session
  end

  -- Serve it, for as long as the window manager runs. Another window
  -- manager already serving the name (a second one nested inside the
  -- first) leaves this one without Settings rather than without windows.
  static fn publish(session: Session) -> nil
    GraphicsCard.start()
    HostInfo.ask()
    -- Find the disks now, beside everything else, so the answer is there
    -- when About or Settings first asks; and each frame, save settings that
    -- have settled and take in what `df` has said.
    Storage.ask()
    local service = SettingsService(session)
    Table.insert(session.chores, fn()
      -- A look chosen in the first-start setup is a setting like any
      -- other: saved, so it is there after a restart.
      if session.lookChanged then
        session.lookChanged = false
        Preferences.saveSoon(service.options())
      end
      Preferences.frame()
      Storage.collect()
    end)
    local saved = Preferences.load()
    if saved != nil then
      service.use(saved!)
    else
      -- Nothing saved yet: the defaults, which for the keyboard is the
      -- layout the installer was told, and for a trackpad its own.
      service.use(WmOptions())
    end
    try
      WmSettings.publish(WmService.name, service)
      SettingsService.log.debug("serving", {service: WmService.name})
    catch e: string
      SettingsService.log.warn("no settings service", {reason: e})
    end
  end

  fn options() -> WmOptions
    local options = WmOptions()
    options.gap = Palette.gap
    options.grab = Palette.grab
    options.resizeStep = Session.resizeStep
    options.newWindows = "beside"
    if self.session.split == Split.Vertical then
      options.newWindows = "below"
    end
    options.windowed = self.session.windowed
    options.dock = self.session.dock
    options.scale = self.session.scale
    options.accent = Palette.accentName
    options.corners = Palette.radius
    options.wallpaper = Palette.wallpaperName
    options.pointerSpeed = Pointer.speed
    options.scrollSpeed = Pointer.scrollSpeed
    options.naturalScrolling = Pointer.natural
    options.primaryButton = "left"
    if Pointer.swapped then
      options.primaryButton = "right"
    end
    options.focusFollowsPointer = Pointer.followsFocus
    options.trackpadSpeed = Pointer.padSpeed
    options.trackpadScrollSpeed = Pointer.padScrollSpeed
    options.trackpadNaturalScrolling = Pointer.padNatural
    options.tapToClick = Pointer.tapToClick
    options.tapAndDrag = Pointer.tapAndDrag
    options.trackpadInertia = Pointer.inertia
    options.pointerAcceleration = Pointer.acceleration
    options.keyboardLayouts = Layouts.written
    options.modKey = Keymap.chosenMod
    local custom: table<string, string> = {}
    for name, keys in Keymap.custom do
      custom[name] = keys
    end
    options.shortcuts = custom
    return options
  end

  fn apply(options: WmOptions)
    self.use(options)
    Preferences.saveSoon(self.options())
    SettingsService.log.info(
      "settings applied",
      {
        gap: Palette.gap,
        corners: Palette.radius,
        accent: Palette.accentName,
        wallpaper: Palette.wallpaperName,
        newWindows: options.newWindows,
        mod: Keymap.scheme(),
        changedKeys: #Table.keys(Keymap.custom),
        pointer: Pointer.speed,
        scroll: Pointer.scrollSpeed,
        natural: Pointer.natural,
        leftHanded: Pointer.swapped,
        followsFocus: Pointer.followsFocus,
      }
    )
  end

  -- Make `options` the window manager's, each kept to its range.
  fn use(options: WmOptions) -> nil
    Palette.gap = Math.clamp(options.gap, 0.0, 24.0)
    Palette.grab = Math.clamp(options.grab, 0.0, 12.0)
    Session.resizeStep = Math.clamp(options.resizeStep, 1, 50)
    Palette.radius = Math.clamp(options.corners, 0.0, 16.0)
    Palette.useAccent(options.accent)
    Palette.useWallpaper(options.wallpaper)
    Keymap.configure(options.modKey, options.shortcuts)
    Pointer.configure(
      options.pointerSpeed,
      options.scrollSpeed,
      options.naturalScrolling,
      options.primaryButton == "right",
      options.focusFollowsPointer,
      options.pointerAcceleration
    )
    Pointer.configureTrackpad(
      options.trackpadSpeed,
      options.trackpadScrollSpeed,
      options.trackpadNaturalScrolling,
      options.tapToClick,
      options.tapAndDrag,
      options.trackpadInertia
    )
    Layouts.configure(options.keyboardLayouts)

    local split = Split.Horizontal
    if options.newWindows == "below" then
      split = Split.Vertical
    end
    self.session.splitNext(split)
    self.session.setWindowed(options.windowed)
    self.session.dock = options.dock
    self.session.setScale(options.scale)
    self.session.refresh()
  end

  fn keys() -> table<string, string>
    return Keymap.written()
  end

  fn recordKeys(on: boolean)
    self.session.recordKeys(on)
    SettingsService.log.debug("recording keys", {on: on})
  end

  fn about() -> SystemInfo
    local info = SystemInfo()
    info.saule = Saule.full
    info.wm = Project.version
    info.machine = SettingsService.machine()
    info.kernel = SettingsService.firstLine("/proc/sys/kernel/osrelease")
    SettingsService.processor(info)
    info.graphics = GraphicsCard.name()
    info.cards = GraphicsCard.cards()
    info.renderer = Graphics.getRenderer()
    info.rendererProblem = Graphics.getRendererProblem()
    SettingsService.memory(info)
    info.uptime = SettingsService.uptime()
    -- What those files didn't say, from the system it runs on.
    HostInfo.fill(info)
    -- The screen's own pixels: its resolution, whatever size things are
    -- drawn at on it.
    local w, h = Window.getSize()
    info.screenWidth = w
    info.screenHeight = h
    info.windows = #self.session.clients
    info.host = Keymap.host
    info.storage = Storage.summary()
    return info
  end

  fn storage() -> StorageReport
    return Storage.report()
  end

  -- The computer as it stands: what `System` last read, what Shine found
  -- plugged in, and what was chosen for it.
  fn machine() -> MachineInfo
    local info = MachineInfo()
    info.managed = System.there
    info.devices = Hardware.devices()

    info.soundCard = System.card
    info.volume = System.volume
    info.muted = System.muted
    info.backlight = System.backlight
    info.brightness = System.brightness

    info.wired = System.wired
    info.cable = System.cable
    info.wiredAddress = System.wiredAddress
    info.radio = System.radio
    info.wifi = System.wifi
    info.wifiName = System.wifiName
    info.wifiSignal = System.wifiSignal
    info.wifiAddress = System.wifiAddress
    local networks: table<WifiNetwork> = {}
    for seen in System.seen do
      local network = WifiNetwork()
      network.name = seen.name
      network.signal = seen.signal
      network.secured = seen.secured
      network.known = seen.known
      Table.insert(networks, network)
    end
    info.networks = networks

    info.battery = System.battery
    info.charge = System.charge
    info.charging = System.charging

    info.name = Machine.name()
    info.timeZone = Machine.zone()
    info.kept = Machine.kept()
    info.person = System.person
    info.account = Os.getenv("USER") ?? ""
    info.hasPassword = System.hasPassword
    info.passwordChanges = System.changes
    info.passwordChange = System.lastChange

    info.microphone = System.microphone
    info.inputVolume = System.inputVolume
    info.inputMuted = System.inputMuted
    info.headphones = System.headphones
    local outputs: table<SoundOutput> = {}
    for card in System.outputs do
      local output = SoundOutput()
      output.index = card.index
      output.name = card.name
      output.chosen = card.chosen
      Table.insert(outputs, output)
    end
    info.outputs = outputs

    info.bluetooth = System.bluetooth
    info.bluetoothScanning = System.bluetoothScanning
    local near: table<BluetoothDevice> = {}
    for found in System.near do
      local device = BluetoothDevice()
      device.address = found.address
      device.name = found.name
      device.paired = found.paired
      device.connected = found.connected
      Table.insert(near, device)
    end
    info.bluetoothDevices = near
    info.passkeyFor = System.passkeyFor
    info.passkey = System.passkey
    info.clockSynced = System.clockSynced
    info.version = System.version
    info.updateState = System.updateState
    info.updateDetail = System.updateDetail

    info.layoutsOffered = Layouts.offered()
    info.layout = Layouts.code()
    return info
  end

  fn layouts() -> table<string>
    return Layouts.all()
  end

  fn zones() -> table<string>
    local out: table<string> = {}
    for zone in Zones.all() do
      Table.insert(out, zone.id .. "\t" .. zone.city .. "\t" .. zone.region)
    end
    return out
  end

  fn setVolume(volume: integer)
    System.setVolume(volume)
    self.session.refresh()
  end

  fn setMuted(muted: boolean)
    System.setMuted(muted)
    self.session.refresh()
  end

  fn setBrightness(percent: integer)
    System.setBrightness(percent)
  end

  fn setRadio(on: boolean)
    System.setRadio(on)
    self.session.refresh()
  end

  fn joinNetwork(name: string, password: string)
    System.join(name, password)
    self.session.refresh()
  end

  fn forgetNetwork(name: string)
    System.forget(name)
  end

  fn scanNetworks()
    System.scan()
  end

  -- Kept as a name a network can carry: what the first-start setup makes
  -- of what is typed. One with no letter or digit in it changes nothing.
  fn setComputerName(name: string)
    local kept = Machine.nameFrom(name)
    if kept != "" then
      Machine.setName(kept)
      SettingsService.log.info("computer named", {name: kept})
    end
  end

  -- A zone the system doesn't list changes nothing.
  fn setTimeZone(zone: string)
    for known in Zones.all() do
      if known.id == zone then
        Machine.setZone(zone)
        self.session.refresh()
        SettingsService.log.info("time zone set", {zone: zone})
        return
      end
    end
  end

  fn setPerson(name: string)
    System.setPerson(name)
  end

  fn setPassword(old: string, new: string)
    System.setPassword(old, new)
    SettingsService.log.info("password change asked for")
  end

  fn setInputVolume(volume: integer)
    System.setInputVolume(volume)
  end

  fn setInputMuted(muted: boolean)
    System.setInputMuted(muted)
  end

  fn setOutput(card: integer)
    System.setOutput(card)
  end

  fn bluetooth(action: string, address: string)
    System.askBluetooth(action, address)
  end

  fn syncClock()
    System.syncClock()
  end

  fn installUpdate(path: string)
    System.installUpdate(path)
    SettingsService.log.info("update asked for", {file: path})
  end

  fn askRestart()
    self.session.confirm("restart")
  end

  fn saveReport()
    self.session.saveReport()
  end

  -- An app saying what it is: known from then on by the process that
  -- said it. Text from another process, so kept to a sensible length.
  fn describeApp(name: string, version: string, about: string, settings: boolean)
    local pid = Looper.callerPid()
    if pid == nil or String.trim(name) == "" then
      return
    end
    local info = AppInfo(
      String.sub(String.trim(name), 1, 40),
      String.sub(String.trim(version), 1, 24),
      String.sub(String.trim(about), 1, 240),
      settings
    )
    self.session.describe(pid!, info)
  end

  fn notify(title: string, body: string)
    local heading = String.sub(String.trim(title), 1, 60)
    if heading != "" then
      self.session.notify(heading, String.sub(String.trim(body), 1, 160))
    end
  end

  -- One app asking for another: a file browser for the editor, with the
  -- file to open.
  fn launch(name: string, arguments: table<string>) -> boolean
    return Launcher.startNamed(name, arguments)
  end

  -- The first line of `path`, or "" where there is no such file (on a
  -- system without `/proc`).
  static fn firstLine(path: string) -> string
    local file = Io.open(path, IoMode.Read)
    if file == nil then
      return ""
    end
    local line = file!.read("l") ?? ""
    file!.close()
    return String.trim(line)
  end

  -- The computer's name from its firmware (DMI): the product, or the maker
  -- when the product says nothing, as a board's "To Be Filled By O.E.M."
  -- does.
  static fn machine() -> string
    local dmi = "/sys/class/dmi/id/"
    local product = SettingsService.firstLine(dmi .. "product_name")
    if product != "" and not String.contains(product, "O.E.M") then
      return product
    end
    return SettingsService.firstLine(dmi .. "sys_vendor")
  end

  -- The processor's name and threads, from `/proc/cpuinfo`: one block per
  -- thread, each with a "model name : …" line.
  static fn processor(info: SystemInfo) -> nil
    local file = Io.open("/proc/cpuinfo", IoMode.Read)
    if file == nil then
      return
    end
    local text = file!.read("a") ?? ""
    file!.close()

    for line in String.split(text, "\n") do
      if String.starts(line, "model name") then
        info.cores += 1
        local parts = String.split(line, ":")
        if info.processor == "" and #parts > 1 then
          -- The kernel pads the name with spaces: "CPU N450   @ 1.66GHz".
          local name = String.trim(parts[2])
          while String.contains(name, "  ") do
            name = String.replace(name, "  ", " ")
          end
          info.processor = name
        end
      end
    end
  end

  -- Memory from `/proc/meminfo`, in kB: all of it ("MemTotal:  2041128
  -- kB"), and what is in use: all but `MemAvailable`, the kernel's own
  -- count of what a new program could have, which is the free memory and
  -- the files it holds only until the room is wanted.
  static fn memory(info: SystemInfo) -> nil
    local file = Io.open("/proc/meminfo", IoMode.Read)
    if file == nil then
      return
    end
    local text = file!.read("a") ?? ""
    file!.close()

    local available = -1
    for line in String.split(text, "\n") do
      if String.starts(line, "MemTotal:") then
        info.memory = SettingsService.kilobytes(line)
      elseif String.starts(line, "MemAvailable:") then
        available = SettingsService.kilobytes(line)
      end
    end
    if available >= 0 then
      info.memoryUsed = Math.max(info.memory - available, 0)
    end
  end

  -- The number in a `/proc/meminfo` line: "MemTotal:  2041128 kB".
  static fn kilobytes(line: string) -> integer
    for word in String.split(line, " ") do
      local number = word as integer?
      if number != nil then
        return number!
      end
    end
    return 0
  end

  -- Whole seconds since boot, from `/proc/uptime`: "8312.54 15873.20".
  static fn uptime() -> integer
    local line = SettingsService.firstLine("/proc/uptime")
    local seconds = (String.split(line, " ")[1] as float?) ?? 0.0
    return seconds as integer
  end
end
