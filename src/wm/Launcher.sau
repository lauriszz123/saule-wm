-- Starting apps: the ones named on the command line when the window
-- manager starts, and any app from the launcher (Super+Space).
--
-- The apps are the programs in `/bin/apps`, as on Saule Linux, and any
-- given on the command line (`saule run . some/app`), which start at once.
-- Nothing in `/bin/apps` starts by itself: apps are opened from the
-- launcher or the system menu.
--
-- Nested on a desktop there is no `/bin/apps`: `SAULE_APPS` names another
-- folder, such as the one saule-linux builds its apps into:
--
--   SAULE_APPS=../saule-linux/build/apps saule run .

from log import Logger
from Program import Program

export class Launcher
  static local log: Logger = Logger("wm.launcher")

  -- Where Saule Linux keeps its apps, unless `SAULE_APPS` says otherwise.
  static folder: string = "/bin/apps"

  -- The apps started from here that may still be running: what Force
  -- Quit ends. They are this process's children, so it can.
  static local running: table<Process> = {}

  -- Which program each process started here is, by its process number:
  -- how a window is known for its app's.
  static local started: table<integer, Program> = {}

  -- The apps that ended by themselves with an error, or were ended by
  -- the system, since `takeFailed` last asked: their names.
  static local failed: table<string> = {}

  -- The program the process `pid` was started as, if it was started here.
  static fn programOf(pid: integer) -> Program?
    return Launcher.started[pid]
  end

  -- Start `apps`, the ones the window manager was started with.
  static fn startApps(apps: table<string>) -> nil
    for path in apps do
      Launcher.start(Program(path))
    end
  end

  -- Every app there is to start: `given` (the command line's), then the
  -- installed ones, each once, sorted by name.
  static fn programs(given: table<string>) -> table<Program>
    local out: table<Program> = {}
    local seen: table<string, boolean> = {}

    for path in given do
      Launcher.addOnce(out, seen, path)
    end
    for path in Launcher.installed() do
      Launcher.addOnce(out, seen, path)
    end

    Table.sort(out, fn(a: Program, b: Program) -> boolean
      return String.lower(a.name) < String.lower(b.name)
    end)
    return out
  end

  -- The programs whose names hold `query`, ignoring case: those that
  -- start with it first, as Spotlight puts them, then the rest. An empty
  -- query matches everything.
  static fn matching(programs: table<Program>, query: string) -> table<Program>
    local wanted = String.lower(String.trim(query))
    local starts: table<Program> = {}
    local contains: table<Program> = {}

    for program in programs do
      local name = String.lower(program.name)
      if String.starts(name, wanted) then
        Table.insert(starts, program)
      elseif String.contains(name, wanted) then
        Table.insert(contains, program)
      end
    end

    for program in contains do
      Table.insert(starts, program)
    end
    return starts
  end

  -- Start `program`, with `arguments` for it when another app asked for
  -- it to open something. False when it could not be started.
  static fn start(program: Program, arguments: table<string> = {}) -> boolean
    local process = Os.spawn(program.path, arguments)
    if process == nil then
      Launcher.log.error("could not start", {path: program.path})
      return false
    end
    Launcher.log.info(
      "app started",
      {name: program.name, path: program.path, pid: process!.pid()}
    )
    Table.insert(Launcher.running, process!)
    Launcher.started[process!.pid()] = program
    return true
  end

  -- Start the installed app called `name`, whatever its case, with
  -- `arguments`. False when there is none by that name.
  static fn startNamed(name: string, arguments: table<string>) -> boolean
    local wanted = String.lower(name)
    for path in Launcher.installed() do
      local program = Program(path)
      if String.lower(program.name) == wanted then
        return Launcher.start(program, arguments)
      end
    end
    Launcher.log.warn("no such app", {name: name})
    return false
  end

  -- Pass on what the apps started here wrote since last time, each frame.
  -- Their output is captured, so unread it would be lost (and pile up in
  -- memory): it goes to the window manager's standard error as it is, so
  -- one terminal shows the apps' log lines with its own. An app that has
  -- ended is let go of once everything it wrote has been passed on.
  static fn pump() -> nil
    for i = #Launcher.running, 1, -1 do
      local process = Launcher.running[i]
      local out = Launcher.text(process.read())
      local err = Launcher.text(process.readErr())
      Io.stderr.write(out .. err)

      if out == "" and err == "" and not process.running() then
        -- Ended already, so this does not wait. Not 0: it gave up with
        -- an error, or (-1) the system ended it.
        local code = process.wait()
        local program = Launcher.started[process.pid()]
        if code != 0 and program != nil then
          Launcher.log.warn("app failed", {name: program!.name, pid: process.pid(), code: code})
          Table.insert(Launcher.failed, program!.name)
        else
          Launcher.log.debug("app ended", {pid: process.pid()})
        end
        Table.remove(Launcher.running, i)
      end
    end
  end

  -- The apps that failed since this was last asked.
  static fn takeFailed() -> table<string>
    local names = Launcher.failed
    Launcher.failed = {}
    return names
  end

  static fn text(data: bytes) -> string
    return Bytes.toString(data) ?? ""
  end

  -- End the app with process id `pid` at once, without asking it: Force
  -- Quit. False when it is not one started here.
  static fn forceQuit(pid: integer) -> boolean
    for i = 1, #Launcher.running do
      local process = Launcher.running[i]
      if process.pid() == pid then
        Launcher.log.debug("app killed", {pid: pid})
        Table.remove(Launcher.running, i)
        return process.kill()
      end
    end
    return false
  end

  -- The programs in `SAULE_APPS`, or else `Launcher.folder`; none when
  -- there is no such folder.
  static fn installed() -> table<string>
    local out: table<string> = {}
    local folder = Os.getenv("SAULE_APPS") ?? Launcher.folder
    if Os.exists(folder) then
      for name in Os.list(folder) do
        Table.insert(out, folder .. "/" .. name)
      end
    end
    return out
  end

  static fn addOnce(
    out: table<Program>,
    seen: table<string, boolean>,
    path: string
  ) -> nil
    if seen[path] == nil then
      seen[path] = true
      Table.insert(out, Program(path))
    end
  end
end
