-- An app the launcher can start: the program file, and the name it shows.

export class Program
  -- The program to run, as `Os.spawn` takes it.
  path: string

  -- What the launcher lists it as: the file's name without its folder or
  -- extension, each word's first letter in capitals — "/bin/apps/terminal"
  -- is "Terminal", "/bin/apps/task-manager" is "Task Manager".
  name: string

  fn init(path: string)
    self.path = path
    self.name = Program.nameOf(path)
  end

  static fn nameOf(path: string) -> string
    local parts = String.split(path, "/")
    local file = parts[#parts]

    -- Up to the last dot, if there is one past the first letter: a
    -- leading dot is part of the name.
    local stem = file
    for i = String.len(file), 2, -1 do
      if String.sub(file, i, i) == "." then
        stem = String.sub(file, 1, i - 1)
        break
      end
    end

    -- A name of several words is written with hyphens between them:
    -- "task-manager" is "Task Manager".
    local words: table<string> = {}
    for word in String.split(stem, "-") do
      if word != "" then
        Table.insert(
          words,
          String.upper(String.sub(word, 1, 1)) .. String.sub(word, 2)
        )
      end
    end
    if #words == 0 then
      return stem
    end
    return String.join(" ", words)
  end
end
