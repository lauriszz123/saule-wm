-- One place in a workspace's layout, i3-style: either a window, or a split
-- that holds more places, side by side or one above another.
--
--     split (side by side)
--     ├── window: Saule Maker
--     └── split (one above another)
--         ├── window: Terminal
--         └── window: Shine demo
--
-- The places in a split share its room by weight: two at 100 get half
-- each, and resizing moves weight from one place to its neighbour.

from Client import Client
from Split import Split

export class Node
  -- The weight a new place starts with: large enough that a resize step
  -- (see `Workspace.resize`) is a small share of it. Weights are whole
  -- numbers so that moving some from one place to another is exact, and a
  -- split's total never drifts however often it is resized.
  static unit: integer = 100

  -- The least weight a place keeps, so resizing never squeezes one away.
  static minimum: integer = 20

  -- The window, when this place is one.
  client: Client?

  -- For a split: which way its places run, and what they are, in order.
  split: Split
  children: table<Node>

  -- Its share of the split it is in, against its siblings' weights.
  weight: integer

  -- The split this place is in; nil at the top.
  parent: Node?

  fn init(client: Client?, split: Split)
    self.client = client
    self.split = split
    self.children = {}
    self.weight = Node.unit
    self.parent = nil
  end

  static fn window(client: Client) -> Node
    return Node(client, Split.Horizontal)
  end

  static fn container(split: Split) -> Node
    return Node(nil, split)
  end

  fn isWindow() -> boolean
    return self.client != nil
  end

  -- Put `node` in this split, at `index` (the end when nil).
  fn insert(node: Node, index: integer? = nil) -> nil
    node.parent = self
    Table.insert(self.children, node, index ?? #self.children + 1)
  end

  -- Move `amount` of weight from `other` to this place, or the other way
  -- when it is negative. Both keep at least `Node.minimum`, so the move
  -- stops short when one would go below it; their sum never changes, and
  -- neither does anything else in the split.
  fn takeWeight(other: Node, amount: integer) -> nil
    local most = other.weight - Node.minimum
    local least = Node.minimum - self.weight
    local moved = Math.clamp(amount, least, most)
    self.weight += moved
    other.weight -= moved
  end

  -- The weight of everything in this split.
  fn totalWeight() -> integer
    local total = 0
    for child in self.children do
      total += child.weight
    end
    return total
  end

  -- Where `child` is in this split, from 1; 0 when it isn't here.
  fn indexOf(child: Node) -> integer
    for i = 1, #self.children do
      if self.children[i] == child then
        return i
      end
    end
    return 0
  end

  -- The first window in here, going in at the start of every split.
  fn firstWindow() -> Node
    if self.isWindow() or #self.children == 0 then
      return self
    end
    return self.children[1].firstWindow()
  end

  -- The last window in here, going in at the end of every split.
  fn lastWindow() -> Node
    if self.isWindow() or #self.children == 0 then
      return self
    end
    return self.children[#self.children].lastWindow()
  end

  -- The place showing `client`, in here or anywhere below.
  fn find(client: Client) -> Node?
    if self.client == client then
      return self
    end

    for child in self.children do
      local found = child.find(client)
      if found != nil then
        return found
      end
    end
    return nil
  end
end
