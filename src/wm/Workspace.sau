-- One screenful of windows: the tiled ones, i3-style, in a tree of splits
-- (see `Node`); the floating ones over them, each at a place of its own;
-- and the window with the keyboard, of either kind.
--
-- A window opened or closed changes only the split it is in: the new place
-- takes the old one's weight, so nothing else on screen moves.

from Client import Client
from Direction import Direction
from Node import Node
from Split import Split

export class Workspace
  -- What the status bar calls it: 1, 2, …
  number: integer

  -- The tiled windows' layout; nil while there are none.
  root: Node?

  -- The floating windows, bottom to top: the last is in front.
  floating: table<Client>

  -- The window with the keyboard while this workspace is on screen.
  focused: Client?

  fn init(number: integer)
    self.number = number
    self.root = nil
    self.floating = {}
    self.focused = nil
  end

  fn isEmpty() -> boolean
    return self.root == nil and #self.floating == 0
  end

  fn has(client: Client) -> boolean
    return self.find(client) != nil or self.floatIndex(client) > 0
  end

  -- Add a window, with the keyboard. A floating one goes in front of the
  -- others. A tiled one goes next to the focused window: if that one's
  -- split already runs the `split` way, the new window joins it, just
  -- after; if not, the focused window becomes a new `split`, holding it
  -- and the new one. With a floating window focused, it goes next to the
  -- last tiled window.
  fn add(client: Client, split: Split) -> nil
    if client.floating then
      Table.insert(self.floating, client)
      self.focused = client
      return
    end

    local window = Node.window(client)
    local root = self.root
    local focused = self.focused
    self.focused = client

    if root == nil then
      self.root = window
      return
    end

    local target = root!.lastWindow()
    if focused != nil then
      target = root!.find(focused!) ?? target
    end

    local parent = target.parent
    if parent != nil and parent!.split == split then
      parent!.insert(window, parent!.indexOf(target) + 1)
      return
    end

    -- The new split takes the focused window's place and weight; inside
    -- it, the two windows start out even.
    local box = Node.container(split)
    self.replace(target, box)
    target.weight = Node.unit
    box.insert(target)
    box.insert(window)
  end

  -- Take a window out. A tiled one's place goes to the one next to it,
  -- which gets the keyboard, and a split left holding one thing is
  -- replaced by that thing. After a floating one, the keyboard goes to the
  -- floating window now in front, or to the tiled ones when there's none.
  fn remove(client: Client) -> nil
    local index = self.floatIndex(client)
    if index > 0 then
      Table.remove(self.floating, index)
      if self.focused == client then
        self.focused = self.front()
      end
      return
    end

    local node = self.find(client)
    if node == nil then
      return
    end

    local parent = node!.parent
    if parent == nil then
      self.root = nil
      if self.focused == client then
        self.focused = self.front()
      end
      return
    end

    local index = parent!.indexOf(node!)
    Table.remove(parent!.children, index)
    local next = parent!.children[Math.min(index, #parent!.children)]

    if #parent!.children == 1 then
      self.replace(parent!, parent!.children[1])
    end

    if self.focused == client then
      self.focused = next.firstWindow().client
    end
  end

  -- Float a tiled window, or tile a floating one; it keeps the keyboard.
  -- Floated, it is centred at the size it had floating last, or its app
  -- asked for; tiled, it goes in as a new window would (see `add`).
  fn toggleFloating(client: Client, split: Split) -> nil
    self.remove(client)
    client.floating = not client.floating
    client.placed = false
    self.add(client, split)
  end

  -- Bring a floating window in front of the others.
  fn raise(client: Client) -> nil
    local index = self.floatIndex(client)
    if index > 0 and index < #self.floating then
      Table.remove(self.floating, index)
      Table.insert(self.floating, client)
    end
  end

  -- The window next to `client` the `direction` way, i3-style: go up the
  -- tree to the first split running that way with something on that side,
  -- then into it, to the window nearest. From a floating window, the way
  -- leads down to the tiled ones: the first of them.
  fn neighbour(client: Client, direction: Direction) -> Client?
    local node = self.find(client)
    if node == nil then
      local root = self.root
      if client.floating and root != nil then
        return root!.firstWindow().client
      end
      return nil
    end

    local split = direction.axis()
    local step = direction.step()

    local place = node!
    while place.parent != nil do
      local parent = place.parent!
      local index = parent.indexOf(place) + step

      if parent.split == split and index >= 1 and index <= #parent.children then
        local side = parent.children[index]
        if step > 0 then
          return side.firstWindow().client
        end
        return side.lastWindow().client
      end
      place = parent
    end
    return nil
  end

  -- Make `client`'s window bigger or smaller, as i3's resize mode does:
  -- Right and Down grow it by `amount` of weight, Left and Up shrink it.
  -- What it grows into is the place next to it, which shrinks by as much.
  --
  -- What is resized is the nearest place round the window that sits in a
  -- split running that way with something beside it. So with a column of
  -- two windows beside a third, Left and Right resize the whole column.
  fn resize(client: Client, direction: Direction, amount: integer) -> nil
    local node = self.find(client)
    if node == nil then
      return
    end

    local grow = amount
    if direction.step() < 0 then
      grow = -amount
    end

    local place = node!
    while place.parent != nil do
      local parent = place.parent!
      local count = #parent.children

      if parent.split == direction.axis() and count > 1 then
        -- The place after it gives the room, or before it for the last.
        local index = parent.indexOf(place)
        local other = parent.children[index + 1]
        if index == count then
          other = parent.children[index - 1]
        end
        place.takeWeight(other, grow)
        return
      end
      place = parent
    end
  end

  -- Swap `client` with the window next to it the `direction` way.
  fn move(client: Client, direction: Direction) -> nil
    local other = self.neighbour(client, direction)
    local here = self.find(client)
    if other == nil or here == nil then
      return
    end

    local there = self.find(other!)
    if there != nil then
      here!.client = other
      there!.client = client
    end
  end

  -- Every window here: the tiled ones in order, then the floating ones
  -- from the back.
  fn clients() -> table<Client>
    local out: table<Client> = {}
    local root = self.root
    if root != nil then
      Workspace.collect(root!, out)
    end
    for client in self.floating do
      Table.insert(out, client)
    end
    return out
  end

  -- The window that should have the keyboard when the focused one goes:
  -- the floating window in front, or else the first tiled one.
  fn front() -> Client?
    if #self.floating > 0 then
      return self.floating[#self.floating]
    end
    local root = self.root
    if root != nil then
      return root!.firstWindow().client
    end
    return nil
  end

  fn find(client: Client) -> Node?
    local root = self.root
    if root == nil then
      return nil
    end
    return root!.find(client)
  end

  -- Where `client` is among the floating windows, or 0 when it isn't one.
  local fn floatIndex(client: Client) -> integer
    for i = 1, #self.floating do
      if self.floating[i] == client then
        return i
      end
    end
    return 0
  end

  -- Put `new` where `old` is, with its weight: the rest of the split
  -- keeps the room it had.
  local fn replace(old: Node, new: Node) -> nil
    new.weight = old.weight
    local parent = old.parent
    if parent == nil then
      self.root = new
      new.parent = nil
      return
    end

    parent!.children[parent!.indexOf(old)] = new
    new.parent = parent
  end

  static fn collect(node: Node, out: table<Client>) -> nil
    if node.client != nil then
      Table.insert(out, node.client!)
    end
    for child in node.children do
      Workspace.collect(child, out)
    end
  end
end
