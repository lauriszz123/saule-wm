-- The apps' windows: which are open, which workspace each is on, and what
-- happens to them. No drawing here; the views in `ui` show what this knows.

import shine
from Client import Client
from Direction import Direction
from Launcher import Launcher
from Program import Program
from SessionEnd import SessionEnd
from Split import Split
from Workspace import Workspace

export class Session
  -- How many workspaces there are.
  static count: integer = 4

  -- How much weight one arrow key moves in resize mode: a tenth of a new
  -- window's (see `Node.unit`).
  static resizeStep: integer = 10

  -- Every window, oldest first, whatever its workspace.
  clients: table<Client>

  workspaces: table<Workspace>

  -- The workspace on screen, by number.
  current: integer

  -- The window with the keyboard, if any: the focused one of the
  -- workspace on screen.
  focused: Client?

  -- Which way the next window splits the focused one.
  split: Split

  -- Resize mode (Super+R): the arrow keys resize the focused window
  -- instead of reaching its app.
  resizing: boolean

  -- The launcher (Super+Space) is open, and has the keyboard.
  launching: boolean

  -- The system menu, behind the sun in the status bar, is open.
  menuOpen: boolean

  -- The screen is locked: the lock screen over everything until it is
  -- unlocked.
  locked: boolean

  -- What is waiting for "are you sure?": "restart", "shutDown" or
  -- "logOut", or "" when nothing is.
  confirming: string

  -- How the window manager is to end (see `SessionEnd`), or 0 while it
  -- runs. The desktop ends the app when this is set.
  exitCode: integer

  -- The apps the window manager was started with, which the launcher
  -- offers as well as the installed ones.
  local given: table<string>

  local started: boolean

  -- Something the screen shows changed, apart from the apps' pixels.
  local changed: boolean

  fn init()
    self.clients = {}
    self.workspaces = {}
    for number = 1, Session.count do
      Table.insert(self.workspaces, Workspace(number))
    end
    self.current = 1
    self.focused = nil
    self.split = Split.Horizontal
    self.resizing = false
    self.launching = false
    self.menuOpen = false
    self.locked = false
    self.confirming = ""
    self.exitCode = 0
    self.given = {}
    self.started = false
    self.changed = false
  end

  -- The workspace on screen.
  fn workspace() -> Workspace
    return self.workspaces[self.current]
  end

  -- `client` has the keyboard now: it was clicked.
  fn focus(client: Client?) -> nil
    if client != nil then
      self.workspaces[client!.workspace].focused = client
    end
    self.sync()
  end

  -- Give the keyboard to the window next to the focused one.
  fn focusToward(direction: Direction) -> nil
    local client = self.focused
    if client == nil then
      return
    end

    local workspace = self.workspace()
    local next = workspace.neighbour(client!, direction)
    if next != nil then
      workspace.focused = next
      self.sync()
    end
  end

  -- Swap the focused window with the one next to it.
  fn moveToward(direction: Direction) -> nil
    local client = self.focused
    if client != nil then
      self.workspace().move(client!, direction)
      self.sync()
    end
  end

  -- Say which way the next window splits the focused one.
  fn splitNext(split: Split) -> nil
    self.split = split
    self.sync()
  end

  -- Start or end resize mode. It only starts with a window to resize.
  fn toggleResizing() -> nil
    self.resizing = not self.resizing and self.focused != nil
    self.sync()
  end

  -- Grow or shrink the focused window, in resize mode: see
  -- `Workspace.resize`.
  fn resize(direction: Direction) -> nil
    local client = self.focused
    if client != nil then
      self.workspace().resize(client!, direction, Session.resizeStep)
      self.sync()
    end
  end

  -- Open the launcher, or close it when it is open. It takes over from
  -- resize mode.
  fn toggleLauncher() -> nil
    self.launching = not self.launching
    self.resizing = false
    self.sync()
  end

  fn closeLauncher() -> nil
    self.launching = false
    self.sync()
  end

  -- Whether the window manager has the keyboard rather than an app: the
  -- launcher, the system menu, a question or the lock screen is up.
  fn ownsKeyboard() -> boolean
    local asking = self.confirming != ""
    return self.launching or self.menuOpen or self.locked or asking
  end

  -- Open the system menu, or close it when it is open.
  fn toggleMenu() -> nil
    self.menuOpen = not self.menuOpen
    self.sync()
  end

  fn closeMenu() -> nil
    self.menuOpen = false
    self.sync()
  end

  -- Ask "are you sure?" before `action`: "restart", "shutDown" or
  -- "logOut".
  fn confirm(action: string) -> nil
    self.menuOpen = false
    self.confirming = action
    self.sync()
  end

  fn cancelConfirm() -> nil
    self.confirming = ""
    self.sync()
  end

  -- Do what was confirmed.
  fn confirmed() -> nil
    match self.confirming
      case "restart" then self.leave(SessionEnd.reboot)
      case "shutDown" then self.leave(SessionEnd.powerOff)
      case "logOut" then self.leave(SessionEnd.logOut)
      case _ then nil
    end
    self.confirming = ""
    self.sync()
  end

  fn lock() -> nil
    self.menuOpen = false
    self.launching = false
    self.resizing = false
    self.locked = true
    self.sync()
  end

  fn unlock() -> nil
    self.locked = false
    self.sync()
  end

  -- End the window manager with `code`, asking every app to close first.
  fn leave(code: integer) -> nil
    for client in self.clients do
      Compositor.requestClose(client.id)
    end
    self.exitCode = code
  end

  -- End the focused window's app at once, without asking it. An app not
  -- started here is asked to close instead: it is not this process's to
  -- end.
  fn forceQuit() -> nil
    self.menuOpen = false
    local client = self.focused
    if client != nil then
      local pid = Compositor.pid(client!.id)
      if pid == nil or not Launcher.forceQuit(pid!) then
        Compositor.requestClose(client!.id)
      end
    end
    self.sync()
  end

  -- Start the app called `name` (as `Program.name` reads, ignoring case),
  -- if there is one: what the system menu's items open.
  fn open(name: string) -> nil
    self.menuOpen = false
    local wanted = String.lower(name)
    for program in self.programs() do
      if String.lower(program.name) == wanted then
        Launcher.start(program)
        break
      end
    end
    self.sync()
  end

  -- Every app the launcher can start.
  fn programs() -> table<Program>
    return Launcher.programs(self.given)
  end

  -- Start `program` from the launcher, and close it. Its window opens next
  -- to the focused one, as any new window does.
  fn launch(program: Program) -> nil
    Launcher.start(program)
    self.closeLauncher()
  end

  -- Something the screen shows changed that the session does not hold —
  -- Settings changed a colour or a gap: redraw.
  fn refresh() -> nil
    self.sync()
  end

  -- Put workspace `number` on screen.
  fn show(number: integer) -> nil
    if number >= 1 and number <= Session.count then
      self.current = number
      self.sync()
    end
  end

  -- Send the focused window to workspace `number`; this one stays on
  -- screen.
  fn sendTo(number: integer) -> nil
    local client = self.focused
    if client == nil or number < 1 or number > Session.count then
      return
    end
    if number == self.current then
      return
    end

    self.workspace().remove(client!)
    self.workspaces[number].add(client!, self.split)
    client!.workspace = number
    self.sync()
  end

  -- Ask the focused window's app to close it.
  fn close() -> nil
    local client = self.focused
    if client != nil then
      Compositor.requestClose(client!.id)
    end
  end

  -- Become the display and start `apps`. Needs the window manager's own
  -- window open first, so it runs on the first frame rather than earlier.
  fn start(apps: table<string>) -> nil
    if self.started then
      return
    end

    self.started = true
    self.given = apps
    Compositor.start()
    Launcher.startApps(apps)
  end

  -- Take in what the apps did since last time. The answer says what the
  -- screen needs: `Changed.Windows` when a window opened, closed, was
  -- renamed or moved, or the keyboard moved; `Changed.Pixels` when only
  -- new frames arrived from windows on screen.
  fn poll() -> Changed
    local changed = Changed.Nothing
    if self.changed then
      self.changed = false
      changed = Changed.Windows
    end

    for ev in Compositor.poll() do
      match ev.kind
        case WindowEventKind.Opened then
          printf("wm: %s opened, id: %d\n", ev.title, ev.id)
          local client = Client(ev.id, ev.title, self.current)
          Table.insert(self.clients, client)
          self.workspace().add(client, self.split)
          self.sync()
          changed = Changed.Windows

        case WindowEventKind.Closed then
          printf("wm: window %d closed\n", ev.id)
          local client = self.find(ev.id)
          if client != nil then
            self.workspaces[client!.workspace].remove(client!)
            self.remove(ev.id)
            self.sync()
          end
          changed = Changed.Windows

        case WindowEventKind.Title then
          local client = self.find(ev.id)
          if client != nil then
            client!.title = ev.title
            changed = Changed.Windows
          end

        case WindowEventKind.Cursor then
          local client = self.find(ev.id)
          if client != nil then
            client!.cursor = ev.cursor
          end

        case WindowEventKind.Frame then
          local client = self.find(ev.id)
          local shown = client != nil and client!.workspace == self.current
          if shown and changed == Changed.Nothing then
            changed = Changed.Pixels
          end

        case _ then nil
      end
    end

    return changed
  end

  fn find(id: integer) -> Client?
    for client in self.clients do
      if client.id == id then
        return client
      end
    end
    return nil
  end

  -- After a change: who has the keyboard now, and redraw. Resize mode
  -- ends with no window left to resize.
  local fn sync() -> nil
    self.focused = self.workspace().focused
    if self.focused == nil then
      self.resizing = false
    end
    self.changed = true
  end

  local fn remove(id: integer) -> nil
    for i = #self.clients, 1, -1 do
      if self.clients[i].id == id then
        Table.remove(self.clients, i)
      end
    end
  end
end

-- What `Session.poll` found.
export enum Changed
  Nothing,
  Pixels,
  Windows
end
