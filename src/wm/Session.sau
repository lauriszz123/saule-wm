-- The apps' windows: which are open, which workspace each is on, and what
-- happens to them. No drawing here; the views in `ui` show what this knows.

import shine
from log import Logger
from Client import Client, Ghost
from Direction import Direction
from Launcher import Launcher
from Program import Program
from SessionEnd import SessionEnd
from Split import Split
from Workspace import Workspace
from Keymap import Keymap
from Machine import Machine
from Setup import Setup
from System import System
from Layouts import Layouts
from AppInfo import AppInfo, Notice

export class Session
  -- How many workspaces there are.
  static count: integer = 4

  static local log: Logger = Logger("wm.session")

  -- How much weight one arrow key moves in resize mode: a tenth of a new
  -- window's (see `Node.unit`).
  static resizeStep: integer = 10

  -- Every window, oldest first, whatever its workspace.
  clients: table<Client>

  workspaces: table<Workspace>

  -- The workspace on screen, by number.
  current: integer

  -- The window with the keyboard, if any: the focused one of the
  -- workspace on screen.
  focused: Client?

  -- Which way the next window splits the focused one.
  split: Split

  -- Resize mode (Super+R): the arrow keys resize the focused window
  -- instead of reaching its app.
  resizing: boolean

  -- The launcher (Super+Space) is open, and has the keyboard.
  launching: boolean

  -- The system menu, behind the sun in the status bar, is open.
  menuOpen: boolean

  -- The screen is locked: the lock screen over everything until it is
  -- unlocked.
  locked: boolean

  -- The lock screen's password: what has been typed, whether the system
  -- is being asked if it is right, and whether the last one was wrong.
  password: string
  checking: boolean
  wrong: boolean

  -- Whether anybody has been let in since the computer started. Until
  -- then the lock screen is the login screen: it also offers to restart
  -- or shut down.
  signedIn: boolean

  -- What a key just changed, shown large over the screen for a moment
  -- as a Mac does: "volume", "brightness" or "layout", or "" for nothing.
  hud: string

  -- Left alone: after how many seconds without a key or the pointer the
  -- screen dims, and after how many it locks. 0 is never. Settings sets
  -- them (`WmOptions`).
  dimAfter: integer
  lockAfter: integer

  -- How much of its brightness the screen keeps when it dims, in
  -- hundredths, and whether what is on it is blurred as well. Settings
  -- sets them too.
  dimTo: integer
  dimBlur: boolean

  -- The screen is dimmed (see `leftAlone`): where it is going. How far
  -- it has got is `dimLevel`, from 0, as it was, to 1, as dim as it
  -- gets: it comes down slowly and lifts fast (`dimStep`).
  dimmed: boolean
  dimLevel: float

  -- How bright the backlight was before it was turned down for that, -1
  -- when it isn't; what it was last asked to be, and when.
  brightBefore: integer
  brightAsked: integer
  brightAskedAt: float

  -- How long the dimming takes to come down, and to lift, in seconds; no
  -- backlight is turned lower than `dimmest`, which can still be read;
  -- and it is asked for a new brightness no more often than this, in
  -- seconds, each asking being a file for the system to read.
  static dimFalls: float = 1.5
  static dimLifts: float = 0.35
  static dimmest: integer = 5
  static dimEvery: float = 0.04

  -- Windowed: every window its own size, dragged about and overlapping,
  -- as on a Mac. Not windowed: tiled. Switching moves the windows there
  -- are (see `setWindowed`).
  windowed: boolean

  -- The Dock is shown along the foot of the screen.
  dock: boolean

  -- How large everything is drawn, as chosen: 0 for what suits the
  -- screen. And the scale in force when the apps were last told it.
  scale: float
  local scaleTold: float

  -- What apps have said of themselves, by process number.
  apps: table<integer, AppInfo>

  -- The menu under the app's name in the bar is open; and the app whose
  -- "About" card is up, if any.
  appMenuOpen: boolean
  appMenuLeft: float
  about: AppInfo?

  -- Notifications on the screen now, oldest first.
  notices: table<Notice>

  -- Windows that have closed, fading away where they were (see `Ghost`),
  -- and for how long, in seconds.
  ghosts: table<Ghost>
  static ghostTime: float = 0.18

  -- The window switcher (Mod+Tab): up while Mod stays held, with the
  -- windows there are, the one used last first, and the one picked so
  -- far. Letting go of Mod goes to it.
  switching: boolean
  switchList: table<Client>
  switchAt: integer

  -- How long a notification stays, in seconds, and how many show at once.
  static noticeTime: float = 5.0
  static mostNotices: integer = 4

  -- The first-start setup is up, over everything, until it has been
  -- through (see `Machine.needsSetup`), and how far it has got.
  settingUp: boolean
  setup: Setup

  -- The accent or the wallpaper was changed here rather than by Settings
  -- (the setup chose one): the settings service saves them and clears
  -- this.
  lookChanged: boolean

  -- The panel open under the bar's right end: "sound", "network" or
  -- "battery", or "" for none.
  panel: string

  -- The window Settings is recording a shortcut in, by id, or 0: every key
  -- goes to it, the window manager's own too (see `recordingKeys`).
  recordingFor: integer

  -- What is waiting for "are you sure?": "restart", "shutDown" or
  -- "logOut", or "" when nothing is.
  confirming: string

  -- How the window manager is to end (see `SessionEnd`), or 0 while it
  -- runs. The desktop ends the app when this is set.
  exitCode: integer

  -- Run at the start of every frame: what the parts of the window manager
  -- that draw nothing do a little at a time (the settings service saves
  -- settings, and takes in what programs it started have answered).
  chores: table<fn() -> nil>

  -- The apps the window manager was started with, which the launcher
  -- offers as well as the installed ones.
  local given: table<string>

  local started: boolean

  -- The window that had the keyboard when this was last settled, by id;
  -- 0 for none.
  local keyboardAt: integer

  -- How many passwords the system had been asked about before this one,
  -- and when it was asked.
  local triedBefore: integer
  local askedAt: float

  -- When the key that `hud` shows was pressed.
  local hudAt: float

  -- How long the system has to answer about a password, and how long
  -- what a key changed stays on the screen, in seconds.
  static patience: float = 15.0
  static hudTime: float = 1.3

  -- How much a press of a volume or a brightness key changes it: a Mac's
  -- sixteen steps.
  static step: integer = 6

  -- Something the screen shows changed, apart from the apps' pixels.
  local changed: boolean

  fn init()
    Keymap.choose()
    self.clients = {}
    self.workspaces = {}
    for number = 1, Session.count do
      Table.insert(self.workspaces, Workspace(number))
    end
    self.current = 1
    self.focused = nil
    self.split = Split.Horizontal
    self.resizing = false
    self.launching = false
    self.menuOpen = false
    self.settingUp = Machine.needsSetup()
    -- A computer with a password starts at its login screen; one being
    -- set up for the first time starts at the setup, whose person it is.
    self.locked = Machine.hasPassword() and not self.settingUp
    self.signedIn = not self.locked
    self.password = ""
    self.checking = false
    self.wrong = false
    self.keyboardAt = 0
    self.triedBefore = 0
    self.askedAt = 0.0
    self.hud = ""
    self.dimAfter = 120
    self.lockAfter = 300
    self.dimTo = 30
    self.dimBlur = true
    self.dimmed = false
    self.dimLevel = 0.0
    self.brightBefore = -1
    self.brightAsked = -1
    self.brightAskedAt = 0.0
    self.hudAt = 0.0
    self.windowed = false
    self.dock = true
    self.scale = 0.0
    self.scaleTold = 0.0
    self.apps = {}
    self.appMenuOpen = false
    self.appMenuLeft = 60.0
    self.about = nil
    self.notices = {}
    self.ghosts = {}
    self.switching = false
    self.switchList = {}
    self.switchAt = 1
    self.setup = Setup()
    self.lookChanged = false
    self.panel = ""
    self.recordingFor = 0
    self.confirming = ""
    self.exitCode = 0
    self.chores = {}
    self.given = {}
    self.started = false
    self.changed = false
  end

  -- The workspace on screen.
  fn workspace() -> Workspace
    return self.workspaces[self.current]
  end

  -- `client` has the keyboard now: it was clicked. A floating window
  -- comes in front of the others.
  fn focus(client: Client?) -> nil
    if client != nil then
      local workspace = self.workspaces[client!.workspace]
      workspace.focused = client
      workspace.raise(client!)
    end
    self.sync()
  end

  -- Settings is (or no longer is) showing a new shortcut's keys, in the
  -- window with the keyboard.
  fn recordKeys(on: boolean) -> nil
    self.recordingFor = 0
    local client = self.focused
    if on and client != nil then
      self.recordingFor = client!.id
    end
  end

  -- Whether every key goes to the focused window. Only while the window
  -- that asked has the keyboard: anywhere else, the shortcuts work.
  fn recordingKeys() -> boolean
    local client = self.focused
    return client != nil and client!.id == self.recordingFor
  end

  -- Give the keyboard to the window next to the focused one.
  fn focusToward(direction: Direction) -> nil
    local client = self.focused
    if client == nil then
      return
    end

    local workspace = self.workspace()
    local next = workspace.neighbour(client!, direction)
    if next != nil then
      workspace.focused = next
      self.sync()
    end
  end

  -- Swap the focused window with the one next to it, or move it a step
  -- that way when it floats.
  fn moveToward(direction: Direction) -> nil
    local client = self.focused
    if client == nil then
      return
    end
    if client!.floating then
      client!.nudgeToward(direction)
    else
      self.workspace().move(client!, direction)
    end
    self.sync()
  end

  -- Draw everything `scale` times its size; 0 is what suits the screen.
  -- Kept to the steps Settings offers. Shine applies it on the bare
  -- screen from its next frame, and `tellScale` passes it on.
  fn setScale(scale: float) -> nil
    local wanted = 0.0
    if scale > 0.0 then
      wanted = Math.clamp(scale, 1.0, 2.5)
    end
    if wanted != self.scale then
      self.scale = wanted
      Window.setScale(wanted)
      Session.log.info("scale chosen", {scale: wanted})
    end
  end

  -- Each frame: when the scale in force has changed, every app is told,
  -- so its window is drawn as large and as sharp as what is around it;
  -- and apps started from now on begin at it (`SHINE_SCALE`).
  fn tellScale() -> nil
    local now = Window.getScale()
    if now == self.scaleTold then
      return
    end
    self.scaleTold = now
    Os.setenv("SHINE_SCALE", tostring(now))
    for client in self.clients do
      Compositor.sendScale(client.id, now)
    end
    self.sync()
  end

  -- Arrange every window as `windowed` says: all floating, each where
  -- and as large as it was last; or tiled again, but for those that were
  -- floated on purpose or can't be tiled (a fixed size).
  fn setWindowed(windowed: boolean) -> nil
    if windowed == self.windowed then
      return
    end
    self.windowed = windowed
    -- The window with the keyboard keeps it through the rearranging.
    local had = self.focused
    -- Back to tiles: those that were tiled before go back where they
    -- were, the last one floated first, which is the order that finds
    -- each its neighbours again (see `Home`); then the rest.
    if not windowed then
      for i = #self.clients, 1, -1 do
        local client = self.clients[i]
        local workspace = self.workspaces[client.workspace]
        local back = client.floating and client.byMode and not client.minimised
        if back and client.resizable and workspace.hasHome(client) then
          workspace.toggleFloating(client, self.split)
          client.byMode = false
        end
      end
    end
    for client in self.clients do
      if client.resizable and not client.minimised then
        local workspace = self.workspaces[client.workspace]
        if windowed and not client.floating then
          workspace.toggleFloating(client, self.split)
          client.byMode = true
        elseif not windowed and client.floating and client.byMode then
          workspace.toggleFloating(client, self.split)
          client.byMode = false
        end
      end
    end
    if had != nil and self.find(had!.id) != nil and not had!.minimised then
      local workspace = self.workspaces[had!.workspace]
      workspace.focused = had
      if had!.floating then
        workspace.raise(had!)
      end
    end
    Session.log.info("windows arranged", {windowed: windowed})
    self.sync()
  end

  -- Tiled to windowed, or back: the settings service saves it.
  fn toggleWindowed() -> nil
    self.setWindowed(not self.windowed)
    self.lookChanged = true
    if self.windowed then
      self.notify("Windowed Mode", "Windows can be moved, resized and overlapped.")
    else
      self.notify("Tiled Mode", "Windows are arranged to fill the screen.")
    end
  end

  -- Put `client` (the focused window when none is given) out of the way,
  -- in the Dock.
  fn minimise(client: Client? = nil) -> nil
    local window = client ?? self.focused
    if window == nil or window!.minimised then
      return
    end
    self.workspaces[window!.workspace].remove(window!)
    window!.minimised = true
    self.appMenuOpen = false
    Session.log.debug("window minimised", {id: window!.id})
    self.sync()
  end

  -- Bring a minimised window back, onto the workspace on screen, with
  -- the keyboard.
  fn restore(client: Client) -> nil
    if not client.minimised then
      return
    end
    client.minimised = false
    client.workspace = self.current
    self.workspace().add(client, self.split)
    self.sync()
  end

  -- The windows in the Dock, oldest first.
  fn minimised() -> table<Client>
    local out: table<Client> = {}
    for client in self.clients do
      if client.minimised then
        Table.insert(out, client)
      end
    end
    return out
  end

  -- Give `client` the keyboard wherever it is: brought back if it was
  -- minimised, its workspace shown if it is on another.
  fn reveal(client: Client) -> nil
    if client.minimised then
      self.restore(client)
      return
    end
    if client.workspace != self.current then
      self.current = client.workspace
    end
    self.workspace().focused = client
    if client.floating then
      self.workspace().raise(client)
    end
    self.sync()
  end

  -- What `client`'s app is called: what it said of itself, else the
  -- program it was started as, else its window's title.
  fn appName(client: Client) -> string
    local pid = Compositor.pid(client.id)
    if pid != nil then
      local info = self.apps[pid!]
      if info != nil then
        return info!.name
      end
      local program = Launcher.programOf(pid!)
      if program != nil then
        return program!.name
      end
    end
    return client.title
  end

  -- What `client`'s app said of itself; made up from its name when it
  -- said nothing.
  fn appInfo(client: Client) -> AppInfo
    local pid = Compositor.pid(client.id)
    if pid != nil then
      local info = self.apps[pid!]
      if info != nil then
        return info!
      end
    end
    return AppInfo(self.appName(client), "", "", false)
  end

  -- The windows of the app called `name`, whatever their state.
  fn windowsOf(name: string) -> table<Client>
    local wanted = String.lower(name)
    local out: table<Client> = {}
    for client in self.clients do
      local pid = Compositor.pid(client.id)
      local program: Program? = nil
      if pid != nil then
        program = Launcher.programOf(pid!)
      end
      if program != nil and String.lower(program!.name) == wanted then
        Table.insert(out, client)
      end
    end
    return out
  end

  -- An app said what it is: kept by its process.
  fn describe(pid: integer, info: AppInfo) -> nil
    self.apps[pid] = info
    self.sync()
  end

  -- The Dock's icon for `program` was clicked: its window comes forward
  -- if it has one, and otherwise it is started.
  fn dockOpen(program: Program) -> nil
    local windows = self.windowsOf(program.name)
    if #windows == 0 then
      self.launch(program)
      return
    end
    -- The one with the keyboard already: on to its next window.
    local target = windows[1]
    for i = 1, #windows do
      if windows[i] == self.focused then
        target = windows[i % #windows + 1]
      end
    end
    self.reveal(target)
  end

  fn toggleAppMenu() -> nil
    self.appMenuOpen = not self.appMenuOpen and self.focused != nil
    self.menuOpen = false
    self.panel = ""
    self.sync()
  end

  fn closeAppMenu() -> nil
    self.appMenuOpen = false
    self.sync()
  end

  -- Show the focused app's "About" card.
  fn showAbout() -> nil
    self.appMenuOpen = false
    local client = self.focused
    if client != nil then
      self.about = self.appInfo(client!)
    end
    self.sync()
  end

  fn closeAbout() -> nil
    self.about = nil
    self.sync()
  end

  -- Have the focused app open its settings: it is sent Ctrl+comma, as a
  -- Mac's apps are sent Command+comma.
  fn openAppSettings() -> nil
    self.appMenuOpen = false
    local client = self.focused
    if client != nil then
      Compositor.sendKey(client!.id, ",", true, false, true, false)
      Compositor.sendKey(client!.id, ",", false, false, true, false)
    end
    self.sync()
  end

  -- Show a notification for a few seconds.
  fn notify(title: string, body: string) -> nil
    Table.insert(self.notices, Notice(title, body, Os.clock()))
    while #self.notices > Session.mostNotices do
      Table.remove(self.notices, 1)
    end
    self.sync()
  end

  -- Each frame: notifications that have been up long enough go.
  fn noticesDue() -> nil
    local now = Os.clock()
    local changed = false
    local kept: table<Notice> = {}
    for notice in self.notices do
      -- Its time is up: it fades out, and then it is off the list.
      if not notice.leaving and now - notice.at >= Session.noticeTime then
        notice.leaving = true
        notice.leftAt = now
        changed = true
      end
      if notice.leaving and now - notice.leftAt >= Notice.fade then
        changed = true
      else
        Table.insert(kept, notice)
      end
    end
    if changed then
      self.notices = kept
      self.sync()
    end
  end

  -- Send `notice` away: it fades out as one whose time is up does.
  fn dismiss(notice: Notice) -> nil
    if not notice.leaving then
      notice.leaving = true
      notice.leftAt = Os.clock()
      self.sync()
    end
  end

  -- A window that has closed while on screen stays one more frame, which
  -- is drawn into a picture (the ui's `WindowMotion`); then it is taken
  -- out, and the picture fades away where it was. And pictures that have
  -- faded are let go of.
  fn leavingDue() -> nil
    local now = Os.clock()
    local changed = false
    for i = #self.clients, 1, -1 do
      local client = self.clients[i]
      if client.leaving and (client.snapshot != nil or now - client.leftAt > 0.25) then
        local picture = client.snapshot
        if picture != nil then
          Table.insert(
            self.ghosts,
            Ghost(picture!, client.seenX, client.seenY, client.seenW, client.seenH, now)
          )
        end
        client.snapshot = nil
        client.picture = nil
        self.workspaces[client.workspace].remove(client)
        Table.remove(self.clients, i)
        changed = true
      end
    end
    local kept: table<Ghost> = {}
    for ghost in self.ghosts do
      if now - ghost.at < Session.ghostTime then
        Table.insert(kept, ghost)
      end
    end
    if #kept != #self.ghosts then
      self.ghosts = kept
      changed = true
    end
    if changed then
      self.sync()
    end
  end

  -- Whether `client`, closing, is seen to go: it is on the screen.
  local fn goes(client: Client) -> boolean
    local here = client.workspace == self.current and not client.minimised
    return here and client.shownAt != nil and client.seenW > 0.0 and not self.locked
  end

  -- The windows there are, the one that had the keyboard last first.
  fn byUse() -> table<Client>
    local out: table<Client> = {}
    for client in self.clients do
      if not client.leaving then
        local at = #out + 1
        while at > 1 and out[at - 1].focusedAt < client.focusedAt do
          at -= 1
        end
        Table.insert(out, client, at)
      end
    end
    return out
  end

  -- The window switcher, a step on (1) or back (-1): brought up by the
  -- first step, at the window used before this one, as a Mac's is.
  fn switchStep(step: integer) -> nil
    if not self.switching then
      local list = self.byUse()
      if #list == 0 then
        return
      end
      self.switchList = list
      self.switching = true
      -- With no window having the keyboard, the first step is to the one
      -- used last.
      self.switchAt = 1
      if self.focused == nil then
        self.switchAt = 0
      end
    end
    local count = #self.switchList
    self.switchAt = (self.switchAt - 1 + step + count * 2) % count + 1
    self.sync()
  end

  -- Mod was let go of: to the window picked, wherever it is.
  fn switchDone() -> nil
    if not self.switching then
      return
    end
    self.switching = false
    -- The list stays as it is: the switcher is still to be seen, going.
    local client = self.switchList[self.switchAt]
    if client != nil and self.find(client.id) != nil and not client.leaving then
      self.reveal(client)
    else
      self.sync()
    end
  end

  -- Away with the switcher, and nothing changed.
  fn switchCancel() -> nil
    if self.switching then
      self.switching = false
      self.sync()
    end
  end

  -- A shortcut as it is said: "Super+Shift+R".
  static fn keysSaid(keys: table<string>) -> string
    local said: table<string> = {}
    for key in keys do
      Table.insert(said, String.upper(String.sub(key, 1, 1)) .. String.sub(key, 2))
    end
    return String.join("+", said)
  end

  -- A report of the computer, for finding out why something does not
  -- work on it, written by the system to the USB drive plugged in. What
  -- the system cannot see for itself is said with it: what draws the
  -- screen, and how.
  fn saveReport() -> nil
    local drawn = Graphics.getRenderer()
    if drawn == "" then
      drawn = "the processor"
    end
    local w, h = Window.getSize()
    local notes = {
      "drawn by=" .. drawn,
      "why=" .. String.replace(Graphics.getRendererProblem(), ";", ","),
      "screen=" .. tostring(w) .. "x" .. tostring(h),
      "scale=" .. tostring(self.scale),
      "windows=" .. tostring(#self.clients),
    }
    if not System.there then
      self.notify("System Report Unavailable", "System reports can only be saved on Saule Linux.")
      return
    end
    System.saveReport(String.join("; ", notes))
    Session.log.info("report asked for")
  end

  -- A picture of the screen as it is, kept in Pictures as a PNG named
  -- for the moment it was taken. The person's Pictures: on Saule Linux
  -- this runs as an account of its own, and `SAULE_PERSON_HOME` says
  -- where the person's files are (init lets it write in that one folder).
  fn screenshot() -> nil
    local home = Os.getenv("SAULE_PERSON_HOME") ?? Os.getenv("HOME") ?? "."
    local folder = home .. "/Pictures"
    Os.mkdir(folder, true)
    local now = Machine.now()
    local name = "Screenshot " .. Os.date("%Y-%m-%d", now) .. " at " .. Os.date(
      "%H.%M.%S",
      now
    ) .. ".png"
    try
      Graphics.captureScreenshot(folder .. "/" .. name)
      Session.log.info("screenshot", {file: name})
      self.notify("Screenshot Saved", name .. " was saved to Pictures.")
    catch e: string
      Session.log.warn("no screenshot", {reason: e})
      self.notify("Screenshot Failed", "The screenshot could not be saved.")
    end
  end

  -- Float `client`, or tile it when it floats: the focused window when
  -- none is given. It has the keyboard after.
  fn toggleFloating(client: Client? = nil) -> nil
    local window = client ?? self.focused
    -- A window of a fixed size always floats: tiled, it would be stretched.
    if window != nil and window!.resizable then
      self.workspaces[window!.workspace].toggleFloating(window!, self.split)
      -- Floated or tiled on purpose now, whatever the mode did.
      window!.byMode = false
      Session.log.debug(
        "window floats",
        {id: window!.id, floating: window!.floating}
      )
      self.sync()
    end
  end

  -- Say which way the next window splits the focused one.
  fn splitNext(split: Split) -> nil
    self.split = split
    self.sync()
  end

  -- Start or end resize mode. It only starts with a window to resize.
  fn toggleResizing() -> nil
    self.resizing = not self.resizing and self.focused != nil
    self.sync()
  end

  -- Grow or shrink the focused window, in resize mode: see
  -- `Workspace.resize`, and `Client.resizeToward` for a floating one.
  fn resize(direction: Direction) -> nil
    local client = self.focused
    if client == nil then
      return
    end
    if client!.floating then
      client!.resizeToward(direction)
    else
      self.workspace().resize(client!, direction, Session.resizeStep)
    end
    self.sync()
  end

  -- Open the launcher, or close it when it is open. It takes over from
  -- resize mode.
  fn toggleLauncher() -> nil
    self.launching = not self.launching
    self.resizing = false
    self.sync()
  end

  fn closeLauncher() -> nil
    self.launching = false
    self.sync()
  end

  -- Whether the window manager has the keyboard rather than an app: the
  -- launcher, the system menu, a question, the lock screen or the
  -- first-start setup is up.
  fn ownsKeyboard() -> boolean
    local asking = self.confirming != ""
    local over = self.locked or self.settingUp or self.panel != ""
    local menus = self.menuOpen or self.appMenuOpen or self.about != nil
    return self.launching or menus or over or asking
  end

  -- The setup's next page; after its last, it has been through and
  -- isn't shown again.
  fn setupNext() -> nil
    if self.setup.next() then
      Machine.setUp()
      self.settingUp = false
      Session.log.info("set up", {name: Machine.name(), zone: Machine.zone()})
    end
    self.sync()
  end

  fn setupBack() -> nil
    self.setup.back()
    self.sync()
  end

  -- The accent or the wallpaper was chosen here: show it, and have it
  -- saved.
  fn lookChosen() -> nil
    self.lookChanged = true
    self.sync()
  end

  -- Open the system menu, or close it when it is open.
  fn toggleMenu() -> nil
    self.menuOpen = not self.menuOpen
    self.appMenuOpen = false
    self.panel = ""
    self.sync()
  end

  -- Open the panel called `name` under the bar, or close it when it is
  -- the one open. One thing hangs from the bar at a time.
  fn togglePanel(name: string) -> nil
    if self.panel == name then
      self.panel = ""
    else
      self.panel = name
    end
    self.menuOpen = false
    self.launching = false
    self.sync()
  end

  fn closePanel() -> nil
    self.panel = ""
    self.sync()
  end

  -- Put the computer to sleep. It wakes locked: the lock screen goes up
  -- as it is asked, so that is what is on the screen when it stops.
  fn sleep() -> nil
    self.lock()
    System.sleep()
  end

  fn closeMenu() -> nil
    self.menuOpen = false
    self.sync()
  end

  -- Ask "are you sure?" before `action`: "restart", "shutDown" or
  -- "logOut".
  fn confirm(action: string) -> nil
    self.menuOpen = false
    self.confirming = action
    self.sync()
  end

  fn cancelConfirm() -> nil
    self.confirming = ""
    self.sync()
  end

  -- Do what was confirmed.
  fn confirmed() -> nil
    match self.confirming
      case "restart" then self.leave(SessionEnd.reboot)
      case "shutDown" then self.leave(SessionEnd.powerOff)
      case "logOut" then self.leave(SessionEnd.logOut)
      case _ then nil
    end
    self.confirming = ""
    self.sync()
  end

  fn lock() -> nil
    self.menuOpen = false
    self.appMenuOpen = false
    self.about = nil
    self.panel = ""
    self.launching = false
    self.resizing = false
    self.locked = true
    self.password = ""
    self.checking = false
    self.wrong = false
    Session.log.info("screen locked")
    self.sync()
  end

  -- Whether the lock screen asks for a password.
  fn needsPassword() -> boolean
    return System.hasPassword or Machine.hasPassword()
  end

  -- A click or Enter on the lock screen: unlocks it where there is no
  -- password, and otherwise does nothing (the password is `submit`ted).
  fn unlock() -> nil
    if self.needsPassword() then
      return
    end
    self.letIn()
  end

  -- The password typed, to be checked: the system says whether it is
  -- right (`answered`), since only it can read what is kept of one.
  fn submit(password: string) -> nil
    if not self.locked or self.checking then
      return
    end
    if not self.needsPassword() then
      self.letIn()
      return
    end
    self.password = password
    self.checking = true
    self.wrong = false
    self.triedBefore = System.tried
    self.askedAt = Os.clock()
    System.unlock(password)
    self.sync()
  end

  -- Each frame while a password is being checked: take the system's
  -- answer when it has come. One that never comes is taken for a no,
  -- not waited for for ever.
  fn answered() -> nil
    if not self.checking then
      return
    end
    if System.tried > self.triedBefore then
      self.checking = false
      if System.lastTry == "right" then
        self.letIn()
        return
      end
      Session.log.info("wrong password")
    elseif Os.clock() - self.askedAt < Session.patience then
      return
    else
      self.checking = false
      Session.log.warn("nobody answered about the password")
    end
    self.wrong = true
    self.password = ""
    self.sync()
  end

  local fn letIn() -> nil
    self.locked = false
    self.signedIn = true
    self.password = ""
    self.checking = false
    self.wrong = false
    Session.log.info("screen unlocked")
    self.sync()
  end

  -- The volume up or down by `steps` presses of its key, shown on the
  -- screen. Turning it up is also turning the sound back on.
  fn volumeBy(steps: integer) -> nil
    if not System.card then
      return
    end
    local volume = System.volume + steps * Session.step
    -- From a value between two steps, to the step: 50, 56, 62, …
    volume = Math.clamp(volume, 0, 100)
    System.setVolume(volume)
    if steps > 0 and System.muted then
      System.setMuted(false)
    end
    self.flash("volume")
  end

  fn toggleMute() -> nil
    if not System.card then
      return
    end
    System.setMuted(not System.muted)
    self.flash("volume")
  end

  -- The computer has been left alone for `idle` seconds, without a key
  -- or the pointer: dim the screen once that is long enough, and lock it
  -- once it is longer; lift the dimming when somebody is back. Dimming
  -- is the backlight turned down, where there is one, and what is on the
  -- screen blurred a little; it comes and goes over a moment (`dimStep`). True when
  -- something changed. Only where this is the computer's own screen: in a
  -- window on another desktop, that desktop does its own.
  fn leftAlone(idle: float) -> boolean
    if Keymap.host != "saule" then
      return false
    end
    -- `SAULE_WM_IDLE=5,10` dims after 5 seconds and locks after 10,
    -- whatever Settings says: for working on this without the wait.
    local asked = String.split(Os.getenv("SAULE_WM_IDLE") ?? "", ",")
    if #asked == 2 then
      self.dimAfter = (asked[1] as integer?) ?? self.dimAfter
      self.lockAfter = (asked[2] as integer?) ?? self.lockAfter
    end
    local changed = false
    local dim = self.dimAfter > 0 and idle >= (self.dimAfter as float)
    if dim != self.dimmed then
      self.dimmed = dim
      if dim then
        Session.log.debug("screen dimmed")
      end
      changed = true
    end
    -- Locking is for a screen there is a password to unlock, and not for
    -- one somebody has yet to set up.
    local lock = self.lockAfter > 0 and idle >= (self.lockAfter as float)
    if lock and not self.locked and not self.settingUp and Machine.hasPassword() then
      Session.log.info("left alone", {seconds: self.lockAfter})
      self.lock()
      changed = true
    end
    return changed
  end

  -- Move the dimming on by `dt` seconds toward where it is going, the
  -- backlight with it. True while it moves: the screen is to be drawn
  -- again, the blur and the shade over it (`Dimmer`) being that much
  -- further.
  fn dimStep(dt: float) -> boolean
    local wanted = 0.0
    if self.dimmed then
      wanted = 1.0
    end
    local level = self.dimLevel
    if level == wanted then
      return false
    end
    if wanted > level then
      level = Math.min(level + dt / Session.dimFalls, wanted)
    else
      level = Math.max(level - dt / Session.dimLifts, wanted)
    end
    self.dimLevel = level
    self.dimBacklight()
    return true
  end

  -- How much of its light the screen has at `level` of the dimming: all
  -- of it at 0, `dimTo` hundredths of it at 1.
  fn lightAt(level: float) -> float
    local kept = (Math.clamp(self.dimTo, 5, 100) as float) / 100.0
    return 1.0 - level * (1.0 - kept)
  end

  -- The backlight as the dimming has it now, where there is one: turned
  -- down from what it was as the dimming comes, and back up to it as the
  -- dimming lifts. What saves a battery.
  fn dimBacklight() -> nil
    if not System.backlight then
      return
    end
    -- As it comes down: what it was is what it goes back to.
    if self.brightBefore < 0 then
      if not self.dimmed then
        return
      end
      self.brightBefore = System.brightness
      self.brightAsked = System.brightness
    end
    local before = self.brightBefore as float
    local now: integer = Math.floor(before * self.lightAt(self.dimLevel) + 0.5)
    if now < Session.dimmest then
      now = Session.dimmest
    end
    if now > self.brightBefore then
      now = self.brightBefore
    end
    -- All the way back: nothing is held any more.
    local over = self.dimLevel <= 0.0
    local clock = Timer.getTime()
    local due = clock - self.brightAskedAt >= Session.dimEvery
    local ends = over or self.dimLevel >= 1.0
    if now != self.brightAsked and (due or ends) then
      System.setBrightness(now)
      self.brightAsked = now
      self.brightAskedAt = clock
    end
    if over then
      self.brightBefore = -1
      self.brightAsked = -1
    end
  end

  -- The backlight as it was, at once, where the dimming holds it: before
  -- a key changes the brightness, which is the brightness it had and not
  -- one on its way back.
  fn dimSettle() -> nil
    if self.brightBefore >= 0 then
      System.setBrightness(self.brightBefore)
      self.brightBefore = -1
      self.brightAsked = -1
    end
  end

  fn brightnessBy(steps: integer) -> nil
    if not System.backlight then
      return
    end
    self.dimSettle()
    System.setBrightness(System.brightness + steps * Session.step)
    self.flash("brightness")
  end

  -- On to the next keyboard layout, where more than one was chosen.
  fn nextLayout() -> nil
    if Layouts.next() then
      self.flash("layout")
    end
  end

  -- Show what a key changed, for a moment.
  local fn flash(what: string) -> nil
    self.hud = what
    self.hudAt = Os.clock()
    self.sync()
  end

  -- Each frame: what a key changed has been on the screen long enough.
  fn hudDue() -> nil
    if self.hud != "" and Os.clock() - self.hudAt >= Session.hudTime then
      self.hud = ""
      self.sync()
    end
  end

  -- End the window manager with `code`, asking every app to close first.
  fn leave(code: integer) -> nil
    Session.log.info("session ending", {code: code, windows: #self.clients})
    for client in self.clients do
      Compositor.requestClose(client.id)
    end
    self.exitCode = code
  end

  -- End the focused window's app at once, without asking it. An app not
  -- started here is asked to close instead: it is not this process's to
  -- end.
  fn forceQuit() -> nil
    self.menuOpen = false
    local client = self.focused
    if client != nil then
      local pid = Compositor.pid(client!.id)
      Session.log.warn(
        "force quit",
        {id: client!.id, title: client!.title, pid: pid ?? 0}
      )
      if pid == nil or not Launcher.forceQuit(pid!) then
        Compositor.requestClose(client!.id)
      end
    end
    self.sync()
  end

  -- Start the app called `name` (as `Program.name` reads, ignoring case),
  -- if there is one: what the system menu's items open.
  fn open(name: string) -> nil
    self.menuOpen = false
    local wanted = String.lower(name)
    local found = false
    for program in self.programs() do
      if String.lower(program.name) == wanted then
        Launcher.start(program)
        found = true
        break
      end
    end
    if not found then
      Session.log.warn("no such app", {name: name})
    end
    self.sync()
  end

  -- Every app the launcher can start.
  fn programs() -> table<Program>
    return Launcher.programs(self.given)
  end

  -- Start `program` from the launcher, and close it. Its window opens next
  -- to the focused one, as any new window does.
  fn launch(program: Program) -> nil
    Launcher.start(program)
    self.closeLauncher()
  end

  -- Something the screen shows changed that the session does not hold —
  -- Settings changed a colour or a gap: redraw.
  fn refresh() -> nil
    self.sync()
  end

  -- Put workspace `number` on screen.
  fn show(number: integer) -> nil
    if number >= 1 and number <= Session.count then
      self.current = number
      Session.log.debug("workspace shown", {number: number})
      self.sync()
    end
  end

  -- Send the focused window to workspace `number`; this one stays on
  -- screen.
  fn sendTo(number: integer) -> nil
    local client = self.focused
    if client == nil or number < 1 or number > Session.count then
      return
    end
    if number == self.current then
      return
    end

    self.workspace().remove(client!)
    self.workspaces[number].add(client!, self.split)
    client!.workspace = number
    Session.log.debug("window sent", {id: client!.id, workspace: number})
    self.sync()
  end

  -- Ask `client`'s app to close it: the focused window's when none is
  -- given.
  fn close(client: Client? = nil) -> nil
    local window = client ?? self.focused
    if window != nil then
      Compositor.requestClose(window!.id)
    end
  end

  -- Become the display and start `apps`. Needs the window manager's own
  -- window open first, so it runs on the first frame rather than earlier.
  fn start(apps: table<string>) -> nil
    if self.started then
      return
    end

    self.started = true
    self.given = apps
    Compositor.start()
    Session.log.info(
      "display started",
      {host: Keymap.host, mod: Keymap.scheme()}
    )
    Launcher.startApps(apps)
  end

  -- Take in what the apps did since last time. The answer says what the
  -- screen needs: `Changed.Windows` when a window opened, closed, was
  -- renamed or moved, or the keyboard moved; `Changed.Pixels` when only
  -- new frames arrived from windows on screen.
  fn poll() -> Changed
    local changed = Changed.Nothing
    if self.changed then
      self.changed = false
      changed = Changed.Windows
    end

    Launcher.pump()
    for name in Launcher.takeFailed() do
      self.notify(
        name .. " Quit Unexpectedly",
        "Press " .. Session.keysSaid(Keymap.report) .. " to save a system report to a USB drive."
      )
    end
    self.tellScale()
    for chore in self.chores do
      chore()
    end

    for ev in Compositor.poll() do
      match ev.kind
        case WindowEventKind.Opened then
          local width = ev.width as float
          local height = ev.height as float
          local client = Client(
            ev.id,
            ev.title,
            self.current,
            width,
            height,
            ev.resizable
          )
          Session.log.info(
            "window opened",
            {
              id: ev.id,
              title: ev.title,
              size: ev.width .. "x" .. ev.height,
              floating: client.floating,
            }
          )
          -- Where every window floats, so does a new one.
          if self.windowed and client.resizable then
            client.floating = true
            client.byMode = true
          end
          Compositor.sendScale(ev.id, Window.getScale())
          Table.insert(self.clients, client)
          self.workspace().add(client, self.split)
          self.sync()
          changed = Changed.Windows

        case WindowEventKind.Closed then
          local client = self.find(ev.id)
          if client != nil then
            Session.log.info("window closed", {id: ev.id, title: client!.title})
            if self.goes(client!) then
              -- Seen to go: see `leavingDue`.
              client!.leaving = true
              client!.leftAt = Os.clock()
            else
              self.workspaces[client!.workspace].remove(client!)
              self.remove(ev.id)
              self.sync()
            end
          end
          changed = Changed.Windows

        case WindowEventKind.Title then
          local client = self.find(ev.id)
          if client != nil then
            Session.log.debug("window renamed", {id: ev.id, title: ev.title})
            client!.title = ev.title
            changed = Changed.Windows
          end

        case WindowEventKind.Cursor then
          local client = self.find(ev.id)
          if client != nil then
            client!.cursor = ev.cursor
          end

        case WindowEventKind.Frame then
          local client = self.find(ev.id)
          local shown = client != nil and client!.workspace == self.current
          if shown and changed == Changed.Nothing then
            changed = Changed.Pixels
          end

        case _ then nil
      end
    end

    return changed
  end

  fn find(id: integer) -> Client?
    for client in self.clients do
      if client.id == id then
        return client
      end
    end
    return nil
  end

  -- After a change: who has the keyboard now, and redraw. Resize mode
  -- ends with no window left to resize.
  local fn sync() -> nil
    self.focused = self.workspace().focused
    -- The window that had the keyboard and hasn't now is told, whatever
    -- took it away (minimised, another workspace shown): a window never
    -- told keeps thinking the keys held at that moment are held still.
    local now = 0
    if self.focused != nil then
      now = self.focused!.id
    end
    if self.keyboardAt != 0 and self.keyboardAt != now and self.find(self.keyboardAt) != nil then
      Compositor.sendFocus(self.keyboardAt, false)
    end
    if self.focused != nil and self.keyboardAt != now then
      self.focused!.focusedAt = Os.clock()
    end
    self.keyboardAt = now
    if self.focused == nil then
      self.resizing = false
    end
    -- Recording ends when its window loses the keyboard.
    if not self.recordingKeys() then
      self.recordingFor = 0
    end
    self.changed = true
  end

  local fn remove(id: integer) -> nil
    for i = #self.clients, 1, -1 do
      if self.clients[i].id == id then
        Table.remove(self.clients, i)
      end
    end
  end
end

-- What `Session.poll` found.
export enum Changed
  Nothing,
  Pixels,
  Windows
end
