-- What an app says of itself (wmapi's `describeApp`), for the menu the
-- bar shows under its name; and a notification, shown for a few seconds.

export class AppInfo
  name: string
  version: string
  about: string
  -- It has settings to open: it is sent Ctrl+comma to open them.
  settings: boolean

  fn init(name: string, version: string, about: string, settings: boolean)
    self.name = name
    self.version = version
    self.about = about
    self.settings = settings
  end
end

export class Notice
  title: string
  body: string
  -- When it was shown, by `Os.clock`.
  at: float

  -- Which one it is, counted from the first: what its card is known by
  -- while others come and go round it.
  id: integer
  static local count: integer = 0

  -- Going: its time is up or it was sent away, and it fades out for
  -- `Notice.fade` seconds from `leftAt` before it is taken off the list.
  leaving: boolean
  leftAt: float
  static fade: float = 0.2

  fn init(title: string, body: string, at: float)
    self.title = title
    self.body = body
    self.at = at
    Notice.count += 1
    self.id = Notice.count
    self.leaving = false
    self.leftAt = 0.0
  end
end
