-- How the computer itself stands — its sound, its network, its battery —
-- and asking it for what the window manager can't do: sleep, a volume, a
-- Wi-Fi network.
--
-- On Saule Linux a program runs as root beside the session for this
-- (saule-linux's `system/`, saule-system). It says how things stand in
-- small files in `/run/saule/system`, read here a couple of times a
-- second, and takes requests as files dropped in `requests/` there: a
-- line of text each. The battery needs nobody's leave: the kernel says
-- how it is in `/sys/class/power_supply`.
--
-- It also keeps the person's password, which the session can't read:
-- the lock screen asks whether what was typed is right (`unlock`), and
-- reads the answer when `tried` has gone up.
--
-- Anywhere else there is no such folder, nothing is shown in the bar, and
-- asking does nothing. `SAULE_SYSTEM=folder` names another, for working
-- on the bar with files written by hand.

from Machine import Machine

-- A Wi-Fi network in range.
export class SeenNetwork
  name: string
  -- 0 to 100.
  signal: integer
  -- It wants a password.
  secured: boolean
  -- It was joined before, and its password is kept.
  known: boolean

  fn init(name: string, signal: integer, secured: boolean, known: boolean)
    self.name = name
    self.signal = signal
    self.secured = secured
    self.known = known
  end
end

-- A sound card that can be played through.
export class SoundCard
  index: integer
  name: string
  chosen: boolean

  fn init(index: integer, name: string, chosen: boolean)
    self.index = index
    self.name = name
    self.chosen = chosen
  end
end

-- A Bluetooth device found or paired.
export class NearDevice
  address: string
  name: string
  paired: boolean
  connected: boolean

  fn init(address: string, name: string, paired: boolean, connected: boolean)
    self.address = address
    self.name = name
    self.paired = paired
    self.connected = connected
  end
end

-- A drive that is plugged in and mounted.
export class Drive
  device: string
  path: string
  label: string

  fn init(device: string, path: string, label: string)
    self.device = device
    self.path = path
    self.label = label
  end
end

export class System
  -- How often the files are read again, in seconds.
  static readEvery: float = 0.4
  static local readAt: float = -1.0

  -- How often the battery is, which changes by the minute.
  static batteryEvery: float = 10.0
  static local batteryAt: float = -100.0

  -- Whether there is anything to ask at all: the folder is there.
  static there: boolean = false

  -- Sound: whether there is a card, its volume from 0 to 100, and
  -- whether it is silenced.
  static card: boolean = false
  static volume: integer = 0
  static muted: boolean = false

  -- How many times the computer has been put to sleep: the screen is
  -- locked when this goes up (see `Desktop.tick`).
  static sleeps: integer = 0

  -- A cable: whether the computer has a place for one, whether one is
  -- in, and the address it was given ("" for none).
  static wired: boolean = false
  static cable: boolean = false
  static wiredAddress: string = ""

  -- Wi-Fi: "none" (no radio), "off" or "on"; then "idle", "joining",
  -- "joined" or "failed", the network that is about, its strength and
  -- the address it gave.
  static radio: string = "none"
  static wifi: string = "idle"
  static wifiName: string = ""
  static wifiSignal: integer = 0
  static wifiAddress: string = ""
  static seen: table<SeenNetwork> = {}

  -- The battery: whether there is one, how full from 0 to 100, and
  -- whether it is being charged.
  static battery: boolean = false
  static charge: integer = 0
  static charging: boolean = false

  -- The screen's backlight: whether there is one to set, and how bright
  -- from 0 to 100.
  static backlight: boolean = false
  static brightness: integer = 0

  -- The microphone (whether the card records, its level, whether it is
  -- off), the headphones' socket ("in", "out" or "none" where the card
  -- doesn't say), and the cards that can be played through.
  static microphone: boolean = false
  static inputVolume: integer = 0
  static inputMuted: boolean = false
  static headphones: string = "none"
  static outputs: table<SoundCard> = {}

  -- Bluetooth: "none", "off" or "on"; whether it is looking; what it
  -- found; and the digits to type on a keyboard being paired.
  static bluetooth: string = "none"
  static bluetoothScanning: boolean = false
  static near: table<NearDevice> = {}
  static passkeyFor: string = ""
  static passkey: string = ""

  -- When the clock was last set from a time server (Unix seconds, 0 for
  -- never), and the drives plugged in.
  static clockSynced: integer = 0
  static drives: table<Drive> = {}

  -- Who the computer is for, and whether there is a password to ask
  -- for. Then how many passwords have been tried and how the last fared
  -- ("right" or "wrong"), and the same for changes of password ("done",
  -- "wrong" or "failed").
  static person: string = ""
  static hasPassword: boolean = false
  static tried: integer = 0
  static lastTry: string = "none"
  static changes: integer = 0
  static lastChange: string = "none"

  -- Everything above as one text: when it differs from the last, the
  -- bar has something new to show.
  static local shown: string = ""
  static local count: integer = 0

  static fn folder() -> string
    return Os.getenv("SAULE_SYSTEM") ?? "/run/saule/system"
  end

  -- Read the files again if it is time. True when what they say changed.
  static fn refresh() -> boolean
    local clock = Os.clock()
    if System.readAt >= 0.0 and clock - System.readAt < System.readEvery then
      return false
    end
    System.readAt = clock

    local folder = System.folder()
    local power = System.read(folder .. "/power")
    local sound = System.read(folder .. "/sound")
    local network = System.read(folder .. "/network")
    local display = System.read(folder .. "/display")
    local login = System.read(folder .. "/login")
    local bluetooth = System.read(folder .. "/bluetooth")
    local clockFile = System.read(folder .. "/clock")
    local disks = System.read(folder .. "/disks")
    System.there = power != "" or sound != "" or network != ""

    System.takePower(power)
    System.takeSound(sound)
    System.takeNetwork(network)
    System.takeDisplay(display)
    System.takeLogin(login)
    System.takeBluetooth(bluetooth)
    System.takeDisks(disks)
    local synced = String.split(System.value(clockFile, "synced"), " ")[1] ?? ""
    System.clockSynced = Machine.whole(synced)
    if clock - System.batteryAt >= System.batteryEvery then
      System.batteryAt = clock
      System.takeBattery()
    end

    local now = power .. sound .. network .. display .. login .. bluetooth .. clockFile .. disks .. tostring(
      System.charge
    ) .. tostring(System.charging) .. tostring(System.battery)
    if now == System.shown then
      return false
    end
    System.shown = now
    return true
  end

  -- Have the files read again at once: something was just asked for.
  static fn soon() -> nil
    System.readAt = -1.0
  end

  static fn read(path: string) -> string
    local file = Io.open(path, IoMode.Read)
    if file == nil then
      return ""
    end
    local text = file!.read("a") ?? ""
    file!.close()
    return text
  end

  -- `name value` lines: the value of the one called `name`, or "".
  static fn value(text: string, name: string) -> string
    for line in String.split(text, "\n") do
      if String.starts(line, name .. " ") then
        return String.trim(String.sub(line, String.len(name) + 2))
      end
    end
    return ""
  end

  static local fn takePower(text: string) -> nil
    System.sleeps = Machine.whole(System.value(text, "sleeps"))
  end

  static local fn takeSound(text: string) -> nil
    System.card = System.value(text, "card") == "1"
    System.volume = Machine.whole(System.value(text, "volume"))
    System.muted = System.value(text, "muted") == "1"

    System.microphone = System.value(text, "input") == "1"
    System.inputVolume = Machine.whole(System.value(text, "input-volume"))
    System.inputMuted = System.value(text, "input-muted") == "1"
    local plugged = System.value(text, "headphones")
    System.headphones = "none"
    if plugged == "1" then
      System.headphones = "in"
    elseif plugged == "0" then
      System.headphones = "out"
    end
    local outputs: table<SoundCard> = {}
    for line in String.split(text, "\n") do
      local fields = String.split(line, "\t")
      if fields[1] == "output" and #fields >= 4 then
        Table.insert(
          outputs,
          SoundCard(Machine.whole(fields[2]), fields[4], fields[3] == "1")
        )
      end
    end
    System.outputs = outputs
  end

  -- See saule-linux's `system/src/bluetooth.rs`.
  static local fn takeBluetooth(text: string) -> nil
    local radio = System.value(text, "radio")
    if radio == "" then
      radio = "none"
    end
    System.bluetooth = radio
    System.bluetoothScanning = System.value(text, "scanning") == "1"
    System.passkeyFor = ""
    System.passkey = ""
    local near: table<NearDevice> = {}
    for line in String.split(text, "\n") do
      local fields = String.split(line, "\t")
      if fields[1] == "device" and #fields >= 5 then
        Table.insert(
          near,
          NearDevice(fields[2], fields[5], fields[3] == "1", fields[4] == "1")
        )
      elseif fields[1] == "passkey" and #fields >= 3 then
        System.passkeyFor = fields[2]
        System.passkey = fields[3]
      end
    end
    System.near = near
  end

  -- See saule-linux's `system/src/disks.rs`.
  static local fn takeDisks(text: string) -> nil
    local drives: table<Drive> = {}
    for line in String.split(text, "\n") do
      local fields = String.split(line, "\t")
      if fields[1] == "drive" and #fields >= 4 then
        Table.insert(drives, Drive(fields[2], fields[3], fields[4]))
      end
    end
    System.drives = drives
  end

  static local fn takeDisplay(text: string) -> nil
    local brightness = System.value(text, "brightness")
    System.backlight = brightness != "" and brightness != "none"
    System.brightness = Machine.whole(brightness)
  end

  -- See saule-linux's `system/src/login.rs`.
  static local fn takeLogin(text: string) -> nil
    System.person = System.value(text, "name")
    System.hasPassword = System.value(text, "password") == "1"
    if Os.getenv("SAULE_WM_PASSWORD") != nil then
      System.hasPassword = true
      return
    end
    local tried = String.split(System.value(text, "tried"), " ")
    if #tried >= 2 then
      System.tried = Machine.whole(tried[1])
      System.lastTry = tried[2]
    end
    local changed = String.split(System.value(text, "changed"), " ")
    if #changed >= 2 then
      System.changes = Machine.whole(changed[1])
      System.lastChange = changed[2]
    end
  end

  -- Lines of fields separated by tabs: see saule-linux's
  -- `system/src/network.rs`.
  static local fn takeNetwork(text: string) -> nil
    System.wired = false
    System.cable = false
    System.wiredAddress = ""
    System.radio = "none"
    System.wifi = "idle"
    System.wifiName = ""
    System.wifiSignal = 0
    System.wifiAddress = ""
    local seen: table<SeenNetwork> = {}

    for line in String.split(text, "\n") do
      local fields = String.split(line, "\t")
      if fields[1] == "wired" and #fields >= 4 then
        -- Of several, the one with a cable in it is the one that counts.
        if not System.cable then
          System.wired = true
          System.cable = fields[3] == "1"
          System.wiredAddress = System.address(fields[4])
        end
      elseif fields[1] == "wifi" and #fields >= 6 then
        System.radio = fields[2]
        System.wifi = fields[3]
        System.wifiSignal = Machine.whole(fields[4])
        System.wifiAddress = System.address(fields[5])
        System.wifiName = fields[6]
      elseif fields[1] == "seen" and #fields >= 5 then
        Table.insert(
          seen,
          SeenNetwork(
            fields[5],
            Machine.whole(fields[2]),
            fields[3] == "1",
            fields[4] == "1"
          )
        )
      end
    end
    System.seen = seen
  end

  static local fn address(field: string) -> string
    if field == "-" then
      return ""
    end
    return field
  end

  -- The first battery the kernel lists: how full it says it is, and
  -- whether it is filling.
  static local fn takeBattery() -> nil
    -- `SAULE_POWER_SUPPLY` names another folder, for working on the
    -- battery's picture on a computer without one.
    local supplies = Os.getenv("SAULE_POWER_SUPPLY") ?? "/sys/class/power_supply"
    System.battery = false
    if not Os.exists(supplies) then
      return
    end
    for name in Os.list(supplies) do
      local supply = supplies .. "/" .. name
      if not System.battery and String.trim(System.read(supply .. "/type")) == "Battery" then
        local full = String.trim(System.read(supply .. "/capacity"))
        if full != "" then
          System.battery = true
          System.charge = Machine.whole(full)
          local status = String.trim(System.read(supply .. "/status"))
          System.charging = status == "Charging" or status == "Full"
        end
      end
    end
  end

  -- Whether the computer is on a network at all, by cable or by Wi-Fi.
  static fn online() -> boolean
    return System.wiredAddress != "" or System.wifiAddress != ""
  end

  -- Ask the computer for something: a line of text, as a file dropped
  -- where saule-system looks. Written beside and renamed in, so it is
  -- never read half-written.
  static fn ask(request: string) -> nil
    if not System.there then
      return
    end
    System.count += 1
    local name = tostring(Os.timeMillis()) .. "-" .. tostring(System.count)
    local path = System.folder() .. "/requests/" .. name
    local file = Io.open(path .. ".part", IoMode.Write)
    if file == nil then
      return
    end
    file!.write(request .. "\n")
    file!.close()
    Os.rename(path .. ".part", path)
    System.soon()
  end

  static fn sleep() -> nil
    System.ask("sleep")
  end

  -- The volume, from 0 to 100. Shown as asked at once: the card's
  -- answer follows within the second.
  static fn setVolume(volume: integer) -> nil
    local asked = Math.clamp(volume, 0, 100)
    System.volume = asked
    if asked > 0 then
      System.muted = false
    end
    System.ask("volume " .. tostring(asked))
  end

  static fn setMuted(muted: boolean) -> nil
    System.muted = muted
    if muted then
      System.ask("mute 1")
    else
      System.ask("mute 0")
    end
  end

  static fn setInputVolume(volume: integer) -> nil
    local asked = Math.clamp(volume, 0, 100)
    System.inputVolume = asked
    System.ask("input " .. tostring(asked))
  end

  static fn setInputMuted(muted: boolean) -> nil
    System.inputMuted = muted
    if muted then
      System.ask("input-mute 1")
    else
      System.ask("input-mute 0")
    end
  end

  static fn setOutput(card: integer) -> nil
    System.ask("output " .. tostring(card))
  end

  -- "on", "off", "scan", or with a device's address "pair", "connect",
  -- "disconnect" or "forget". Anything else is not passed on.
  static fn askBluetooth(action: string, address: string) -> nil
    local alone = action == "on" or action == "off" or action == "scan"
    local withDevice = action == "pair" or action == "connect" or action == "disconnect" or action == "forget"
    if alone then
      System.ask("bluetooth " .. action)
    elseif withDevice and String.len(address) == 17 and not String.contains(address, " ") then
      System.ask("bluetooth " .. action .. " " .. address)
    end
  end

  static fn syncClock() -> nil
    System.ask("clock sync")
  end

  -- The screen's brightness, from 0 to 100; shown as asked at once.
  static fn setBrightness(percent: integer) -> nil
    local asked = Math.clamp(percent, 0, 100)
    System.brightness = asked
    System.ask("brightness " .. tostring(asked))
  end

  -- Is `password` the person's? The answer is `lastTry`, once `tried`
  -- has gone up. Spaces at either end don't count: a request is a line.
  static fn unlock(password: string) -> nil
    -- With a password standing in (`Machine.hasPassword`), this answers
    -- for the system that isn't there.
    local standIn = Os.getenv("SAULE_WM_PASSWORD")
    if standIn != nil then
      System.tried += 1
      System.lastTry = "wrong"
      if String.trim(password) == standIn! then
        System.lastTry = "right"
      end
      return
    end
    System.ask("unlock " .. String.trim(password))
  end

  static fn setPassword(old: string, new: string) -> nil
    System.ask("password " .. String.trim(old) .. "\t" .. String.trim(new))
  end

  static fn setPerson(name: string) -> nil
    System.person = String.trim(name)
    System.ask("person " .. String.trim(name))
  end

  static fn setRadio(on: boolean) -> nil
    if on then
      System.radio = "on"
      System.ask("wifi on")
    else
      System.radio = "off"
      System.ask("wifi off")
    end
  end

  static fn scan() -> nil
    System.ask("wifi scan")
  end

  -- Join the Wi-Fi network called `name`, with `password` when it wants
  -- one that isn't kept.
  static fn join(name: string, password: string) -> nil
    System.wifi = "joining"
    System.wifiName = name
    if password == "" then
      System.ask("wifi join " .. name)
    else
      System.ask("wifi join " .. name .. "\t" .. password)
    end
  end

  static fn forget(name: string) -> nil
    System.ask("wifi forget " .. name)
  end
end
