-- One app's window on the screen: its pixels, with rounded corners, an
-- outline and a soft shadow, and the mouse passed on to it. The keyboard
-- comes through `ClientWindow`, which wraps this.

import shine
from uikit import *
from wm import Client
from Palette import Palette

export class ClientView extends View
  client: Client

  -- What clicking gives the keyboard to: the `Focus` around this view.
  node: FocusNode

  -- Whether this window has the keyboard: its outline says so.
  focused: boolean

  -- Under a floating window's title bar, in its frame (see
  -- `FloatingWindow`), which draws the outline and the shadow: the pixels
  -- only, square at the top where they meet the bar, round at the bottom.
  decorated: boolean

  -- The pointer moving onto the window gives it the keyboard, without a
  -- click (Settings' "focus follows the pointer").
  follows: boolean

  fn init(
    client: Client,
    node: FocusNode,
    focused: boolean,
    decorated: boolean = false,
    follows: boolean = false,
    key: string? = nil
  )
    self.super(key)
    self.client = client
    self.node = node
    self.focused = focused
    self.decorated = decorated
    self.follows = follows
  end

  -- Take all the room there is, and tell the app when that changes: the
  -- window manager decides a window's size, the app redraws at it.
  --
  -- The app is told its size in the screen's own pixels, and draws at
  -- the scale everything here is drawn at (`Compositor.sendScale`): its
  -- pixels then go on the screen one for one, and its text is as sharp
  -- as the bar's.
  fn layout(el: Element, constraints: Constraints) -> Size
    local size = constraints.biggest()
    local scale = Display.scale()
    local w = Math.floor(size.width * scale + 0.5)
    local h = Math.floor(size.height * scale + 0.5)

    local scratch = el.data.scratch
    local resized = w != (scratch.w as integer?) or h != (scratch.h as integer?)

    if resized then
      el.data.scratch.w = w
      el.data.scratch.h = h
      if w > 0 and h > 0 then
        Compositor.configure(self.client.id, w, h)
      end
    end

    return size
  end

  fn paint(el: Element, x: float, y: float) -> nil
    local w = el.size.width
    local h = el.size.height
    local r = Palette.radius
    -- The app's latest picture, or the last there was of a window that
    -- has closed and is on its way off the screen.
    local image = Compositor.image(self.client.id)
    if image != nil then
      self.client.picture = image
    else
      image = self.client.picture
    end

    if not self.decorated then
      ClientView.shadow(x, y, w, h)
    end

    if image != nil then
      -- While the app catches up with a new size, its last frame can be
      -- bigger than the window: keep it inside.
      Graphics.push("all")
      Graphics.intersectScissor(x, y, w, h)
      -- Shine tints an image with the current colour: white leaves it be.
      Graphics.setColor(1.0, 1.0, 1.0)
      -- The app's pixels are the screen's own: drawn with the scaling
      -- of everything else here undone, a pixel to a pixel.
      local s = Display.scale()
      Graphics.push()
      Graphics.scale(1.0 / s, 1.0 / s)
      if self.decorated then
        ClientView.squareTop(image!, x * s, y * s, w * s, h * s, r * s)
      else
        Graphics.drawRounded(image!, x * s, y * s, r * s)
      end
      Graphics.pop()
      Graphics.pop()
    else
      -- Nothing from the app yet (it is reading a file, or the machine
      -- is slow): a window's own dark, not a frame with the desktop
      -- showing through it.
      Palette.windowBlank.apply()
      Graphics.rectangle("fill", x, y, w, h, r)
    end

    if self.decorated then
      return
    end

    -- The outline, on the pixels just inside the edge.
    if self.focused then
      Palette.focusOutline.apply()
    else
      Palette.outline.apply()
    end
    Graphics.setLineWidth(1.0)
    Graphics.rectangle("line", x + 0.5, y + 0.5, w - 1.0, h - 1.0, r)
  end

  -- The app's pixels with only the bottom corners round: the top half
  -- drawn as it is, the bottom half rounded, each clipped to its half, so
  -- every pixel is still drawn once. Shine rounds all four corners or none.
  static fn squareTop(
    image: Image,
    x: float,
    y: float,
    w: float,
    h: float,
    r: float
  ) -> nil
    local half = Math.floor(h / 2.0) as float
    Graphics.push("all")
    Graphics.intersectScissor(x, y, w, half)
    Graphics.draw(image, x, y)
    Graphics.pop()
    Graphics.intersectScissor(x, y + half, w, h - half)
    Graphics.drawRounded(image, x, y, r)
  end

  -- A soft shadow just outside the window: rings that get fainter going
  -- out. Two pixels, so it fits in the gap between windows.
  static fn shadow(x: float, y: float, w: float, h: float) -> nil
    Graphics.setLineWidth(1.0)

    for i = 1, 2 do
      local out = (i as float) - 0.5
      local alpha = Palette.shadow / (i * i) as float
      local r = Palette.radius + out
      local grow = 2.0 * out

      Graphics.setColor(0.0, 0.0, 0.0, alpha)
      Graphics.rectangle("line", x - out, y - out, w + grow, h + grow, r)
    end
  end

  -- An app's window hides what is behind it.
  fn occludes(el: Element) -> boolean
    return true
  end

  -- The mouse, in this window's own coordinates. A press keeps the window
  -- hearing the mouse until it's released, even outside it.
  fn handleEvent(
    el: Element,
    event: PointerEvent,
    x: float,
    y: float,
    inside: boolean
  ) -> boolean
    local id = self.client.id
    local data = el.data

    match event.kind
      case PointerKind.Move then
        -- In the app's pixels, which are the screen's.
        if inside or data.pressed then
          local s = Display.scale()
          Compositor.sendPointer(id, x * s, y * s)
        end
        if inside then
          Cursors.request(self.client.cursor)
          if self.follows and not self.focused then
            self.node.requestFocus()
          end
        elseif data.hovered then
          Compositor.sendLeave(id)
        end
        data.hovered = inside
        return false

      case PointerKind.Down then
        if not inside then
          return false
        end
        self.node.requestFocus()
        data.pressed = true
        Compositor.sendButton(id, event.button, true)
        return true

      case PointerKind.Up then
        if not data.pressed then
          return false
        end
        data.pressed = false
        Compositor.sendButton(id, event.button, false)
        return true

      case PointerKind.Scroll then
        if not inside then
          return false
        end
        Compositor.sendWheel(id, event.scrollX, event.scrollY)
        return true
    end

    return false
  end
end
