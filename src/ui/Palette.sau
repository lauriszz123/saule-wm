-- The window manager's colours and sizes, in one place.

from uikit import Color
from "wmapi" import Presets, Rgba

export class Palette
  -- The accent and the wallpaper, by name (see wmapi's `Presets`): what
  -- Settings sees and sends. The accent's colours below are its; the
  -- wallpaper is drawn from its name (wmapi's `WallpaperArt`).
  static accentName: string = "blue"
  static wallpaperName: string = "dusk"

  -- The status bar is frosted glass: what is behind it blurred this far
  -- under this tint, both full along the top and fading out over the
  -- lower `barFade` of it into the wallpaper.
  static barBlur: float = 20.0
  static barTint: Color = Color(0.06, 0.06, 0.10, 0.42)
  static barFade: float = 0.65

  -- The lock screen has no bar, so no shade along the top: it darkens
  -- toward every edge instead, this dark in the corners.
  static vignette: float = 0.55
  static text: Color = Color(1.0, 1.0, 1.0)
  static dimText: Color = Color(1.0, 1.0, 1.0, 0.78)
  static accent: Color = Color(0.48, 0.64, 0.97)

  -- Nothing at all: for a background or border a view must not draw.
  static clear: Color = Color(0.0, 0.0, 0.0, 0.0)

  -- A workspace's button in the bar when it isn't the one on screen.
  static workspace: Color = Color(1.0, 1.0, 1.0, 0.16)

  -- Windows: how round their corners are, their 1px outline (the accent on
  -- the one with the keyboard), and how dark their shadow starts.
  static radius: float = 8.0
  static outline: Color = Color(1.0, 1.0, 1.0, 0.22)
  static focusOutline: Color = Color(0.48, 0.64, 0.97)
  static shadow: float = 0.25

  -- Floating windows: their title bar, as a Mac's, its title, and its
  -- buttons (close, minimise, zoom), grey on a window without the
  -- keyboard. Their shadow is deeper than a tiled window's: they stand
  -- over the others.
  static titleHeight: float = 28.0
  static titleBar: Color = Color(0.20, 0.20, 0.22)
  -- What a window shows before its app has drawn anything.
  static windowBlank: Color = Color(0.12, 0.12, 0.14)
  static titleText: Color = Color(1.0, 1.0, 1.0, 0.85)
  static closeButton: Color = Color(1.0, 0.37, 0.34)
  static minimiseButton: Color = Color(1.0, 0.74, 0.18)
  static zoomButton: Color = Color(0.16, 0.79, 0.25)
  static idleButton: Color = Color(1.0, 1.0, 1.0, 0.22)
  static buttonSize: float = 12.0
  static floatShadow: float = 0.30

  -- Resize mode's pill in the status bar: warm, so it is not mistaken for
  -- a workspace.
  static resizeMode: Color = Color(0.98, 0.64, 0.33)

  -- The launcher (Super+Space), after Spotlight: a dark glass bar a little
  -- way down the screen, with what matches listed under it as you type.
  -- Frosted: what is behind it blurred `launcherBlur` pixels wide, under
  -- the tint `launcher`.
  static launcher: Color = Color(0.11, 0.11, 0.14, 0.55)
  static launcherBlur: float = 30.0

  -- How blurred the lock screen is as it starts to come and as it goes.
  static lockBlur: float = 48.0

  -- How blurred the wallpaper behind the lock screen's time is, as a
  -- Mac's lock screen softens it; 0 for sharp.
  static lockWallpaperBlur: float = 10.0

  -- "Are you sure?" (see `ConfirmDialog`): the screen behind blurred this
  -- far and dimmed by this tint; the card's width, corners and button
  -- height, and the Cancel button's glassy grey.
  static confirmScreenBlur: float = 8.0
  static confirmScreenTint: Color = Color(0.0, 0.0, 0.0, 0.28)
  static confirmWidth: float = 300.0
  static confirmRadius: float = 14.0
  static confirmButton: float = 30.0
  static confirmCancel: Color = Color(1.0, 1.0, 1.0, 0.14)
  static launcherOutline: Color = Color(1.0, 1.0, 1.0, 0.16)
  static launcherWidth: float = 600.0
  static launcherTop: float = 120.0
  static launcherRadius: float = 26.0
  static launcherRows: integer = 6

  -- How wide the system menu behind the sun is.
  static menuWidth: float = 270.0

  -- The tile behind an app's first letter in the launcher's list.
  static badge: Color = Color(1.0, 1.0, 1.0, 0.18)

  -- Sizes.
  static barHeight: float = 28.0
  static padding: float = 12.0

  -- Space between windows, and between them and the screen's edges.
  static gap: float = 4.0

  -- How far into the windows either side of a gap the pointer can still
  -- grab it to resize them: a 4px gap alone is hard to hit, and harder on
  -- a touchpad.
  static grab: float = 4.0

  -- Use the accent called `name`: the lit workspace, the focused window's
  -- outline and the launcher's pick.
  static fn useAccent(name: string) -> nil
    local preset = Presets.find(Presets.accents, name)
    Palette.accentName = preset.name
    Palette.accent = Palette.colour(preset.colours[1])
    Palette.focusOutline = Palette.accent
  end

  -- Use the wallpaper called `name`, of any kind. `Wallpaper` sees the
  -- name change and draws it again.
  static fn useWallpaper(name: string) -> nil
    Palette.wallpaperName = Presets.wallpaper(name).name
  end

  static fn colour(c: Rgba) -> Color
    return Color(c.r, c.g, c.b, c.a)
  end
end
