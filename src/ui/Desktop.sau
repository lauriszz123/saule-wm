-- The whole screen: the wallpaper, the status bar along the top, and the
-- windows of the workspace on screen below it: the tiled ones with a gap
-- around each, and the floating ones over them. The launcher, when it is
-- open, goes over all of it.

from uikit import *
from wm import Changed, Direction, Keymap, Node, Session, Split, System
from Palette import Palette
from Wallpaper import Wallpaper
from StatusBar import StatusBar
from ClientWindow import ClientWindow
from SplitView import SplitView
from FloatingLayer import FloatingLayer
from LauncherView import LauncherView
from Transition import Transition
from SystemMenu import SystemMenu
from ConfirmDialog import ConfirmDialog
from LockScreen import LockScreen
from SetupAssistant import SetupAssistant
from StatusPanel import StatusPanel
from Hud import Hud
from Dock import Dock
from Notices import Notices
from AppMenu import AppMenu
from AppAbout import AppAbout
from Keys import Keys
from log import Logger

export class Desktop extends View
  static local log: Logger = Logger("wm.keys")

  session: Session
  apps: table<string>

  fn init(session: Session, apps: table<string>, key: string? = nil)
    self.super(key)
    self.session = session
    self.apps = apps
  end

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return true
  end

  -- Each frame, take in what the apps did: rebuild when windows came or
  -- went or a setting changed, just repaint when only their pixels did.
  fn tick(el: Element, dt: float) -> nil
    -- Restart, Shut Down or Log Out was confirmed: end, and the session's
    -- exit code tells init which (see `SessionEnd`).
    if self.session.exitCode != 0 then
      App.quit()
      return
    end

    self.session.start(self.apps)

    -- How the computer stands, a couple of times a second: the bar shows
    -- it. And when it has been put to sleep, by the lid or by anything
    -- else, what wakes is a locked screen.
    local slept = System.sleeps
    if System.refresh() then
      if System.sleeps > slept and not self.session.locked then
        self.session.lock()
      end
      el.markNeedsBuild()
    end
    -- A password being checked has its answer, and what a key changed
    -- has been shown long enough.
    self.session.answered()
    self.session.hudDue()
    self.session.noticesDue()

    -- A drive plugged in or let go of is said.
    local bag: table = el.data.scratch
    local drives: table<string> = {}
    for drive in System.drives do
      Table.insert(drives, drive.label)
    end
    local now = String.join("\n", drives)
    local before = bag.drives as string?
    if before != nil and now != before! then
      if #drives > #String.split(before!, "\n") or before! == "" then
        local label = drives[#drives] ?? ""
        if label == "" then
          label = "USB Drive"
        end
        self.session.notify("Drive connected", label .. " is in Files, under Locations.")
      end
    end
    bag.drives = now

    -- Answer what other programs asked since the last frame (Settings,
    -- through `SettingsService`), without waiting for more.
    Looper.dispatch(0)

    match self.session.poll()
      case Changed.Windows then el.markNeedsBuild()
      case Changed.Pixels then Repaint.request()
      case Changed.Nothing then nil
    end
  end

  fn body(context: BuildContext) -> View
    local session = self.session

    -- The Dock has a strip of its own along the foot, so no window is
    -- ever under it.
    local screen = VStack(alignment: StackAlignment.Fill) do
      StatusBar(session)
      Desktop.windows(session).padding(Palette.gap).expanded()
      if session.dock then
        Dock(session).frame(height: Dock.height)
      end
    end

    -- Over the windows: the launcher, the system menu, a question, and
    -- the lock screen over everything. Each comes and goes with a motion,
    -- so their layers are always there (see `Transition`).
    local launcher = Desktop.cover(Desktop.launcher(session), "launcher")
    local menu = Desktop.cover(Desktop.menu(session), "menu")
    local confirm = Desktop.cover(Desktop.question(session), "confirm")
    local panel = Desktop.cover(Desktop.panel(session), "panel")
    local appMenu = Desktop.cover(Desktop.appMenu(session), "appMenu")
    local about = Desktop.cover(Desktop.about(session), "about")
    local layers: table<View> = {
      screen,
      Desktop.cover(Notices(session), "notices"),
      launcher,
      menu,
      appMenu,
      panel,
      about,
      confirm,
    }
    Table.insert(layers, Desktop.cover(Desktop.lockScreen(session), "lock"))
    Table.insert(layers, Desktop.cover(Desktop.setup(session), "setup"))
    -- Over everything, the lock screen too: the volume keys work there.
    Table.insert(layers, Desktop.cover(Desktop.hud(session), "hud"))

    local shortcuts = fn(e: KeyEvent) -> boolean
      return Desktop.shortcut(session, e)
    end

    local all = ZStack(children: layers)
    local desktop = KeyboardListener(onKeyDown: shortcuts, child: all)
    return Wallpaper(child: desktop)
  end

  -- The window manager's own keys, whichever window has focus. They are
  -- held with its key, "Mod": Super on Saule Linux, as a Mac's Command,
  -- and another nested in a desktop that keeps Super for itself (see
  -- `Keymap`, which also has the ones that differ):
  --
  --   Mod + arrows              the keyboard to the window that way
  --   Mod + Shift + arrows      swap the window with the one that way
  --   Mod + 1…4                 that workspace
  --   Mod + Shift + 1…4         send the window to that workspace
  --   Mod + H / V               the next window goes beside / below
  --   Mod + Shift + Space       float the window, or tile it
  --   Mod + R                   resize mode (see `resizeKey`)
  --   Mod + Shift + Q           close the window
  --   `Keymap.launcher`         the launcher (Super + Space)
  --   `Keymap.lock`             lock the screen (Ctrl + Super + Q)
  --   `Keymap.forceQuit`        force quit (Alt + Super + Escape)
  --   `Keymap.layout`           the next keyboard layout (Ctrl + Space)
  --   `Keymap.quit`             quit the window manager
  --
  -- And the keys with a picture on them, which need holding with nothing
  -- (see `machineKey`): the volume, the brightness, sleep and power.
  static fn shortcut(session: Session, e: KeyEvent) -> boolean
    Desktop.log.trace(
      "key",
      {
        key: e.key,
        ctrl: e.ctrl,
        alt: e.alt,
        shift: e.shift,
        meta: e.meta,
      }
    )

    if Keys.pressed(e, Keymap.quit) then
      App.quit()
      return true
    end

    -- The computer's own keys, whatever is on the screen: the volume can
    -- be turned down at the lock screen, and a password typed in the
    -- right layout.
    if Desktop.machineKey(session, e) then
      return true
    end

    -- The first-start setup has it before anything else is in use.
    if session.settingUp then
      return Desktop.setupKey(session, e)
    end

    -- The lock screen, a question or the system menu has the keyboard.
    if session.locked or session.confirming != "" or session.menuOpen then
      return Desktop.overlayKey(session, e)
    end
    -- So has the app's menu, and the card about an app: Escape closes.
    if session.appMenuOpen or session.about != nil then
      if e.key == "escape" or e.key == "return" then
        session.closeAppMenu()
        session.closeAbout()
      end
      return true
    end

    if session.resizing then
      return Desktop.resizeKey(session, e)
    end

    -- A panel under the bar: Escape closes it, and what else is typed is
    -- for a field in it (a network's password).
    if session.panel != "" then
      if e.key == "escape" then
        session.closePanel()
        return true
      end
      return false
    end

    -- The shortcuts first, whatever they are held with: Settings may have
    -- moved one off Mod. Then the arrows and numbers, which are Mod's.
    if Desktop.command(session, e) then
      Desktop.log.debug("shortcut", {key: e.key})
      return true
    end
    if Keys.modHeld(e) then
      return Desktop.moveKey(session, e)
    end
    return false
  end

  -- The keys a laptop has pictures on, which Shine names, and the
  -- keyboard layout's shortcut. Each is done and, where there is
  -- something to see, shown for a moment (`Hud`).
  --
  --   volume up / down, mute       the sound card's
  --   brightness up / down         the screen's backlight
  --   sleep                        sleep, locked
  --   power                        "Shut down?", unless the screen is
  --                                locked or the setup is up
  static fn machineKey(session: Session, e: KeyEvent) -> boolean
    match e.key
      case "volumeup" then session.volumeBy(1)
      case "volumedown" then session.volumeBy(-1)
      case "mute" then session.toggleMute()
      case "brightnessup" then session.brightnessBy(1)
      case "brightnessdown" then session.brightnessBy(-1)
      case "sleep" then session.sleep()
      case "printscreen" then session.screenshot()
      case "power" then
        if not session.locked and not session.settingUp then
          session.confirm("shutDown")
        end
      case _ then
        if not Keys.pressed(e, Keymap.layout) then
          return false
        end
        session.nextLayout()
    end
    return true
  end

  -- The shortcut `e` is, done; false when it is none.
  static fn command(session: Session, e: KeyEvent) -> boolean
    if Keys.pressed(e, Keymap.launcher) then
      session.toggleLauncher()
    elseif Keys.pressed(e, Keymap.float) then
      session.toggleFloating()
    elseif Keys.pressed(e, Keymap.resize) then
      session.toggleResizing()
    elseif Keys.pressed(e, Keymap.lock) then
      session.lock()
    elseif Keys.pressed(e, Keymap.forceQuit) then
      session.forceQuit()
    elseif Keys.pressed(e, Keymap.minimise) then
      session.minimise()
    elseif Keys.pressed(e, Keymap.windowed) then
      session.toggleWindowed()
    elseif Keys.pressed(e, Keymap.screenshot) then
      session.screenshot()
    elseif Keys.pressed(e, Keymap.close) then
      session.close()
    elseif Keys.pressed(e, Keymap.beside) then
      session.splitNext(Split.Horizontal)
    elseif Keys.pressed(e, Keymap.below) then
      session.splitNext(Split.Vertical)
    else
      return false
    end
    return true
  end

  -- Mod with an arrow or a number, and Shift to take the window along.
  static fn moveKey(session: Session, e: KeyEvent) -> boolean
    local shift = Keys.modWith(e, true)
    if not shift and not Keys.modWith(e, false) then
      return false
    end

    local direction = Desktop.direction(e.key)
    if direction != nil then
      if shift then
        session.moveToward(direction!)
      else
        session.focusToward(direction!)
      end
      return true
    end

    local number = Desktop.workspaceKey(e.key)
    if number > 0 then
      if shift then
        session.sendTo(number)
      else
        session.show(number)
      end
      return true
    end
    return false
  end

  -- Resize mode, as in i3: every key is the window manager's until it
  -- ends, so a stray letter does not reach the app.
  --
  --   arrows                    Right / Down grow the window, Left / Up
  --                             shrink it
  --   Escape, Enter, Mod + R    done
  static fn resizeKey(session: Session, e: KeyEvent) -> boolean
    local direction = Desktop.direction(e.key)
    if direction != nil then
      session.resize(direction!)
    elseif e.key == "escape" or e.key == "return" or e.key == "r" then
      session.toggleResizing()
    end
    return true
  end

  -- A key while the lock screen, a question or the system menu is up:
  -- all of them are the window manager's, so none reaches an app.
  --
  --   locked        Enter unlocks; with a password, every key is left
  --                 to the field it is typed in, Enter too
  --   a question    Enter does it, Escape doesn't
  --   the menu      Escape closes it
  static fn overlayKey(session: Session, e: KeyEvent) -> boolean
    if session.locked then
      if session.needsPassword() then
        return false
      end
      if e.key == "return" then
        session.unlock()
      end
    elseif session.confirming != "" then
      if e.key == "return" then
        session.confirmed()
      elseif e.key == "escape" then
        session.cancelConfirm()
      end
    elseif e.key == "escape" then
      session.closeMenu()
    end
    return true
  end

  -- A key while the first-start setup is up. None is a shortcut: nothing
  -- else is in use yet.
  --
  --   Enter     the next page, where no field has the keyboard (a field
  --             acts on Enter itself)
  --   Escape    the page before
  --
  -- Every other key is left to the field being typed in.
  static fn setupKey(session: Session, e: KeyEvent) -> boolean
    if e.key == "return" and not session.setup.typing() then
      session.setupNext()
      return true
    end
    if e.key == "escape" then
      session.setupBack()
      return true
    end
    return false
  end

  -- The first-start setup: there when the window manager starts, and
  -- fading away over the desktop when it has been through.
  static fn setup(session: Session) -> View
    local shown = fn() -> boolean
      return session.settingUp
    end
    local content = fn() -> View
      return SetupAssistant(session)
    end
    return Transition(shown, content, 0.30, 1.0)
  end

  -- The launcher, settling in as Spotlight does: fading in and growing
  -- the last few percent about its search bar.
  static fn launcher(session: Session) -> View
    local shown = fn() -> boolean
      return session.launching
    end
    local content = fn() -> View
      return LauncherView(session)
    end
    local bar = Palette.launcherTop + Palette.launcherRadius
    return Transition(shown, content, 0.16, 0.96, anchorY: bar)
  end

  -- The system menu, fading in and out as a Mac's menus do: quickly, and
  -- without a change of size, which would move it off the sun it hangs
  -- from.
  static fn menu(session: Session) -> View
    local shown = fn() -> boolean
      return session.menuOpen
    end
    local content = fn() -> View
      return SystemMenu(session)
    end
    return Transition(shown, content, 0.12, 1.0)
  end

  -- A panel under the bar's right end, fading in and out as the system
  -- menu does.
  static fn panel(session: Session) -> View
    local shown = fn() -> boolean
      return session.panel != ""
    end
    local content = fn() -> View
      return StatusPanel(session)
    end
    return Transition(shown, content, 0.12, 1.0)
  end

  -- "Are you sure?" before the session ends, fading in over the screen as
  -- the screen behind blurs (see `ConfirmDialog`). A fade only: the
  -- blurred, dimmed screen is the whole screen from the start, and
  -- growing it would leave its edges uncovered.
  static fn question(session: Session) -> View
    local shown = fn() -> boolean
      return session.confirming != ""
    end
    local content = fn() -> View
      return ConfirmDialog(session)
    end
    return Transition(shown, content, 0.18, 1.0)
  end

  -- The app's menu, under its name in the bar.
  static fn appMenu(session: Session) -> View
    local shown = fn() -> boolean
      return session.appMenuOpen
    end
    local content = fn() -> View
      return AppMenu(session, session.appMenuLeft)
    end
    return Transition(shown, content, 0.12, 1.0)
  end

  -- The card about an app.
  static fn about(session: Session) -> View
    local shown = fn() -> boolean
      return session.about != nil
    end
    local content = fn() -> View
      local info = session.about
      if info == nil then
        return Spacer()
      end
      return AppAbout(session, info!)
    end
    return Transition(shown, content, 0.15, 0.97)
  end

  -- What a key just changed, fading in and out quickly.
  static fn hud(session: Session) -> View
    local shown = fn() -> boolean
      return session.hud != ""
    end
    local content = fn() -> View
      return Hud(session)
    end
    return Transition(shown, content, 0.15, 1.0)
  end

  -- The lock screen, as a Mac's: locking fades it in over the desktop,
  -- coming out of a blur as it does; unlocking blurs it again as it fades
  -- out, and the desktop is there behind it. Without the launcher's change
  -- of size: across the whole screen, that is more than a netbook can draw
  -- smoothly.
  static fn lockScreen(session: Session) -> View
    local shown = fn() -> boolean
      return session.locked
    end
    local content = fn() -> View
      return LockScreen(session)
    end
    return Transition(shown, content, 0.35, 1.0, blur: Palette.lockBlur)
  end

  -- `view` over the whole screen, as the layer called `name`. Named, so
  -- that it stays the same layer when one before it comes or goes: the
  -- system menu closes as the screen locks, and a lock screen taken for a
  -- new layer would start its motion already finished.
  static fn cover(view: View, name: string) -> View
    return Positioned(
      left: 0.0,
      top: 0.0,
      right: 0.0,
      bottom: 0.0,
      child: view,
      key: name
    )
  end

  static fn direction(key: string) -> Direction?
    match key
      case "left" then
        return Direction.Left
      case "right" then
        return Direction.Right
      case "up" then
        return Direction.Up
      case "down" then
        return Direction.Down
      case _ then
        return nil
    end
  end

  -- The workspace a number key picks, or 0 for any other key.
  static fn workspaceKey(key: string) -> integer
    for number = 1, Session.count do
      if key == tostring(number) then
        return number
      end
    end
    return 0
  end

  -- The workspace on screen's windows: the tiled ones laid out as its
  -- tree says, and the floating ones over them. Both layers are always
  -- there, so a window floating or settling back never rebuilds the rest.
  static fn windows(session: Session) -> View
    local floating = FloatingLayer(session)
    local layers = {
      Desktop.cover(Desktop.tiled(session), "tiled"),
      Desktop.cover(floating, "floating"),
    }
    return ZStack(children: layers)
  end

  -- The tiled windows, or nothing. Only the view that is used is made: in
  -- a builder's block, a view made and left over would join it as a child.
  static fn tiled(session: Session) -> View
    local root = session.workspace().root
    if root == nil then
      return Spacer()
    end
    return Desktop.tile(root!, session)
  end

  -- A place in the tree: a window, or a split of places side by side or
  -- one above another, sharing the room by weight (see `SplitView`).
  static fn tile(node: Node, session: Session) -> View
    local client = node.client
    if client != nil then
      return ClientWindow(client!, session, key: tostring(client!.id))
    end

    local places: table<View> = {}
    for child in node.children do
      Table.insert(places, Desktop.tile(child, session))
    end
    return SplitView(node, places)
  end
end
