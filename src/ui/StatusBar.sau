-- The bar along the top of the screen: always there, whatever the layout.
-- Frosted glass, as a Mac's menu bar is: the wallpaper behind it blurred
-- under a dark tint, both full along the top edge and melting away toward
-- the bar's bottom, so the bar has no edge of its own.
--
--   ☀  [1] 2  3   Saule Maker                     Tue 24 Nov  14:05
--
-- The sun is where a Mac has its apple: clicking it opens the system
-- menu (see `SystemMenu`). The workspaces are i3's: the one on screen
-- lit, the others that have windows shown, the empty ones left out. Click
-- one to go there. In resize mode a pill after them says so, and how to
-- get out.

from uikit import *
-- `Client` too: `session.focused` is one, and its fields need the type.
from wm import Client, Session
from Palette import Palette
from Clock import Clock
from SunLogo import SunLogo

export class StatusBar extends View
  session: Session

  fn init(session: Session, key: string? = nil)
    self.super(key)
    self.session = session
  end

  fn body(context: BuildContext) -> View
    local session = self.session

    local title = ""
    if session.focused != nil then
      title = session.focused!.title
    end

    local row = HStack(spacing: 10.0) do
      StatusBar.sun(session)
      StatusBar.workspaces(session)
      if session.resizing then
        StatusBar.resizing()
      end
      Text(title).font(13.0).foregroundStyle(Palette.dimText)
      Spacer()
      Clock()
    end

    local inset = EdgeInsets.symmetric(horizontal: Palette.padding)
    local glass = Backdrop(
      child: row.padding(insets: inset),
      blur: Palette.barBlur,
      tint: Palette.barTint,
      fade: Palette.barHeight * Palette.barFade
    )
    return glass.frame(height: Palette.barHeight)
  end

  -- The sun, lit while its menu is open, as a Mac lights its apple.
  static fn sun(session: Session) -> View
    local fill: Color? = nil
    if session.menuOpen then
      fill = Palette.workspace
    end
    local logo = SunLogo(Palette.text).frame(width: 18.0, height: 18.0)
    local inset = EdgeInsets.symmetric(horizontal: 6.0, vertical: 2.0)
    local shown = logo.padding(insets: inset).background(fill, 5.0)
    local open = fn()
      session.toggleMenu()
    end
    return GestureArea(child: shown, onTap: open)
  end

  static fn workspaces(session: Session) -> View
    return HStack(spacing: 4.0) do
      for workspace in session.workspaces do
        local number = workspace.number
        local shown = number == session.current

        if shown or not workspace.isEmpty() then
          local go = fn()
            session.show(number)
          end
          GestureArea(child: StatusBar.workspace(number, shown), onTap: go)
        end
      end
    end
  end

  -- Resize mode's pill, and how to get out of it.
  static fn resizing() -> View
    local label = Text("Resize").font(12.0).foregroundStyle(Palette.text)
    local inset = EdgeInsets.symmetric(horizontal: 7.0, vertical: 1.0)
    local pill = label.padding(insets: inset)
    local hint = Text("arrows to resize, Esc when done")
    return HStack(spacing: 6.0) do
      pill.background(Palette.resizeMode, 5.0)
      hint.font(12.0).foregroundStyle(Palette.dimText)
    end
  end

  -- One workspace's button: its number on a pill, lit when it's on screen.
  static fn workspace(number: integer, shown: boolean) -> View
    local fill = Palette.workspace
    local text = Palette.dimText
    if shown then
      fill = Palette.accent
      text = Palette.text
    end

    local label = Text(tostring(number)).font(12.0).foregroundStyle(text)
    local inset = EdgeInsets.symmetric(horizontal: 7.0, vertical: 1.0)
    return label.padding(insets: inset).background(fill, 5.0)
  end
end
