-- An app's window with the keyboard: what has focus here, the app gets.
-- The keyboard follows the session: when a shortcut gives a window the
-- keyboard, this takes it. While the launcher is open or the session is
-- in resize mode, the keyboard is the window manager's instead.

import shine
from uikit import *
from wm import Client, Session
from ClientView import ClientView

export class ClientWindow extends View
  client: Client
  session: Session

  fn init(client: Client, session: Session, key: string? = nil)
    self.super(key)
    self.client = client
    self.session = session
  end

  -- It has a tick to run: see `View.ticks`.
  fn ticks() -> boolean
    return true
  end

  -- Take the keyboard when the session says this window has it. A window
  -- just put on screen isn't ready to take it on its first frame, so this
  -- asks each frame until it has it, rather than once.
  fn tick(el: Element, dt: float) -> nil
    local node = nodeFor(el.data)

    -- While the window manager has the keyboard (the launcher, the system
    -- menu, a question, the lock screen), let go of it: the launcher's
    -- search field only takes it while nothing else has it, and the rest
    -- hear keys nothing has taken. It comes back here when they close.
    if self.session.ownsKeyboard() then
      if node.hasFocus() then
        node.unfocus()
      end
      return
    end

    if self.session.focused == self.client and not node.hasFocus() then
      node.requestFocus()
    end
  end

  fn body(context: BuildContext) -> View
    local client = self.client
    local session = self.session
    local id = client.id
    local node = nodeFor(context.data())

    return Focus(
      node: node,
      wantsText: true,
      onKeyDown: fn(e: KeyEvent) -> boolean
        return ClientWindow.forwardKey(session, id, e, true)
      end,
      onKeyUp: fn(e: KeyEvent) -> boolean
        return ClientWindow.forwardKey(session, id, e, false)
      end,
      onText: fn(text: string) -> boolean
        -- Typed with Super held, it was a shortcut (Super+Shift+2 types
        -- "@"); typed in resize mode, it was a stray key. Neither is the
        -- app's.
        if Keyboard.isAnyDown({"lgui", "rgui"}) or session.resizing then
          return false
        end
        Compositor.sendText(id, text)
        return true
      end,
      onFocusChange: fn(focused: boolean)
        -- A window that has just closed loses the keyboard too, and
        -- `Compositor` has no window left to tell.
        if session.find(id) == nil then
          return
        end
        Compositor.sendFocus(id, focused)
        if focused then
          session.focus(client)
        end
      end,
      child: ClientView(self.client, node, session.focused == client)
    )
  end

  -- Pass a key on to the app, except the window manager's own shortcuts,
  -- and every key in resize mode, which go on up to the desktop.
  static fn forwardKey(
    session: Session,
    id: integer,
    e: KeyEvent,
    down: boolean
  ) -> boolean
    if e.meta or (e.ctrl and e.alt) or session.resizing then
      return false
    end

    Compositor.sendKey(id, e.key, down, e.shift, e.ctrl, e.alt)
    return true
  end
end
